# Plausible Analytics (self-hosted, Community Edition) — production env
# =======================================================================
# Copy to /tmp/plausible.env on the Manager VPS, fill in REAL values, then deploy via Dokploy:
#
#   docker compose \
#     --env-file /tmp/plausible.env \
#     -f deploy/plausible/docker-compose.yml \
#     config > /tmp/plausible-final.yaml
#
# Upload /tmp/plausible-final.yaml to Dokploy UI as a new Compose project on the Manager.
# NEVER commit the real env file — it contains secrets.
# -----------------------------------------------------------------------

# --- Public host (must match DNS A-record pointing to Manager VPS) ---
PLAUSIBLE_HOST=analytics.lucoze.com
BASE_URL=https://analytics.lucoze.com

# --- Secrets (generate fresh, store in password manager) ---
# Generate: openssl rand -base64 64 | tr -d '\n'
SECRET_KEY_BASE=CHANGE_ME_64_BYTE_RANDOM
# Generate: openssl rand -base64 32 | tr -d '\n'
TOTP_VAULT_KEY=CHANGE_ME_32_BYTE_RANDOM
# Generate: openssl rand -base64 24 | tr -d '\n'
POSTGRES_PASSWORD=CHANGE_ME

# --- Registration policy ---
# invite_only = first user via CLI; all others must be invited (recommended for private instance)
# true        = registration disabled entirely (every user via CLI)
# false       = open signups (do NOT use)
DISABLE_REGISTRATION=invite_only

# --- Email (intentionally left unconfigured) ---
# We start without SMTP. Plausible falls back to the local mail adapter (logs emails to stdout,
# does not deliver). New users are added via CLI:
#
#   docker exec -it <plausible-container> /entrypoint.sh user create \
#     --email user@lucoze.com --name "Full Name" --password "<strong-password>"
#
# To wire AWS SES later, uncomment and fill the block below, then add the matching env keys
# back into deploy/plausible/docker-compose.yml under the `plausible:` service.
#
# MAILER_EMAIL=analytics@lucoze.com
# SMTP_HOST_ADDR=email-smtp.ap-south-1.amazonaws.com
# SMTP_HOST_PORT=587
# SMTP_HOST_SSL_ENABLED=false
# SMTP_USER_NAME=<SES_SMTP_USERNAME>
# SMTP_USER_PWD=<SES_SMTP_PASSWORD>
