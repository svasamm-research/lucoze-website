{
	"name": "lucoze-website",
	"version": "1.0.0",
	"private": true,
	"description": "Lucoze healthcare management platform marketing website",
	"scripts": {
		"test": "jest",
		"test:coverage": "jest --coverage",
		"lint": "prettier --check '**/*.{js,css,html}'",
		"format": "prettier --write '**/*.{js,css,html}'",
		"prepare": "husky",
		"dev": "astro dev",
		"dev:clean": "rm -rf .astro node_modules/.vite && astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.0.0",
		"@commitlint/config-conventional": "^19.0.0",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"husky": "^9.0.0",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"prettier": "^3.0.0",
		"prettier-plugin-astro": "^0.14.1"
	},
	"dependencies": {
		"@astrojs/mdx": "^5.0.6",
		"@astrojs/react": "^5.0.5",
		"@astrojs/sitemap": "^3.7.2",
		"astro": "^6.4.8",
		"astro-og-canvas": "^0.13.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"overrides": {
		"picomatch@>=4.0.0 <4.0.4": "4.0.4",
		"picomatch@>=2.0.0 <3.0.0": "2.3.2",
		"devalue@<5.8.1": "5.8.1",
		"vite@<7.3.5": "^7.3.5"
	}
}
