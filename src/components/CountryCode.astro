---
// The country picker that sits before a phone number on lucoze.com's forms (Mithun, 10 Nov 2026):
// India first, then every country A–Z; the closed box shows "🇮🇳 +91" and follows the choice.
// The list is src/data/countries.json, generated by web-dev tools/gen_countries.py from Google's
// libphonenumber — the same file svasamm.com and t4suite.com use. The form's script reads the chosen
// option's data-min / data-max to check the number, and sends "+<code> <number>"
// (src/lib/lead-form.ts: phoneCheck).
import COUNTRIES from "../data/countries.json";

interface Props {
	for: string; // the phone input's id, so the picker's name reads with it
}
const first = COUNTRIES[0];
---

<span class="reach-phone__cc cc" data-cc-wrap>
	<span aria-hidden="true" data-cc-show>{first.f} +{first.d}</span>
	<svg class="cc-caret" aria-hidden="true" width="12" height="12" viewBox="0 0 12 12"><path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
	<select aria-label={`Country code, now ${first.n} +${first.d}`} aria-controls={Astro.props.for} data-cc>
		{COUNTRIES.map((c) => (
			<option value={c.c} data-d={c.d} data-f={c.f} data-n={c.n} data-min={c.min} data-max={c.max}>
				{`${c.f} ${c.n} (+${c.d})`}
			</option>
		))}
	</select>
</span>

<style>
	.cc {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding: 0 10px 0 12px;
		font-size: 15px;
		font-weight: 600;
		white-space: nowrap;
		color: var(--ink);
		background: var(--bg-code, #ede9df);
		border: 1.5px solid var(--line, #e2e0d8);
		border-right: none;
		border-radius: var(--r-md, 10px) 0 0 var(--r-md, 10px);
	}
	.cc select {
		position: absolute;
		inset: 0;
		width: 100%;
		opacity: 0;
		cursor: pointer;
	}
	.cc:focus-within {
		outline: 2px solid var(--primary);
		outline-offset: -2px;
	}
	.cc-caret {
		flex: none;
		font-weight: 400;
		opacity: 0.6;
	}
</style>

<script>
	// Keep the closed box's "🇮🇳 +91" in step with the country chosen.
	document.querySelectorAll<HTMLElement>("[data-cc-wrap]").forEach((w) => {
		const sel = w.querySelector<HTMLSelectElement>("[data-cc]")!;
		const show = w.querySelector<HTMLElement>("[data-cc-show]")!;
		sel.addEventListener("change", () => {
			const o = sel.selectedOptions[0];
			show.textContent = `${o.dataset.f} +${o.dataset.d}`;
			sel.setAttribute("aria-label", `Country code, now ${o.dataset.n} +${o.dataset.d}`);
		});
	});
</script>
