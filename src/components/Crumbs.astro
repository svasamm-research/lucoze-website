---
interface Crumb {
	href?: string;
	label: string;
}

interface Props {
	items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
	{
		items.map((c, i) => (
			<>
				{c.href ? <a href={c.href}>{c.label}</a> : <span class="crumbs-current">{c.label}</span>}
				{i < items.length - 1 && <span class="crumbs-sep">→</span>}
			</>
		))
	}
</nav>
