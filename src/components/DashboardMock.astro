---
/**
 * DashboardMock.astro — static dashboard mock (multi-specialty defaults).
 * Phase B renders this as a fixed snapshot; Phase C will replace it with
 * a React island that swaps content per specialty + tab.
 *
 * Used by HeroDemo + the "Pick your specialty" section on the home page.
 */
import Icon from "./Icon.astro";

interface Props {
	chromeTitle?: string;
	mainSub?: string;
}

const {
	chromeTitle = "app.lucoze.com · Multi-specialty clinic",
	mainSub = "Today · Multi-specialty clinic",
} = Astro.props;

const NAV = [
	{ key: "appt", label: "Appointments", icon: "calendar", active: true, badge: null },
	{ key: "pat", label: "Patients", icon: "users", active: false, badge: null },
	{ key: "bill", label: "Billing", icon: "receipt", active: false, badge: "3" },
	{ key: "lab", label: "Lab", icon: "flask", active: false, badge: null },
	{ key: "pharm", label: "Pharmacy", icon: "pill", active: false, badge: null },
	{ key: "rep", label: "Reports", icon: "chart", active: false, badge: null },
];

const METRICS = [
	{ label: "Patients today", value: "48", trend: "+12%" },
	{ label: "Revenue (MTD)", value: "₹4.2L", trend: "+18%" },
	{ label: "Pending invoices", value: "9", trend: "-3", trendDown: true },
];

const ROWS = [
	{
		time: "09:30",
		initials: "AR",
		patient: "Aparna Roy",
		with: "Dr. Sen · OPD",
		status: "Checked in",
		pill: "ok",
	},
	{
		time: "10:00",
		initials: "RB",
		patient: "Rajiv Banerjee",
		with: "Dr. Chatterjee · Cardiology",
		status: "In room 2",
		pill: "info",
	},
	{
		time: "10:30",
		initials: "PS",
		patient: "Priya Singh",
		with: "Dr. Sen · OPD",
		status: "Running late",
		pill: "warn",
	},
	{
		time: "11:00",
		initials: "SD",
		patient: "Sutapa Das",
		with: "Dr. Mukherjee · Dermatology",
		status: "Confirmed",
		pill: "ok",
	},
	{
		time: "11:30",
		initials: "MP",
		patient: "M. Pradhan",
		with: "Dr. Sen · OPD",
		status: "Confirmed",
		pill: "ok",
	},
];
---

<div class="dash">
	<div class="dash__chrome">
		<span class="dash__dot"></span>
		<span class="dash__dot"></span>
		<span class="dash__dot"></span>
		<span class="dash__chrome-title">{chromeTitle}</span>
	</div>
	<div class="dash__layout">
		<div class="dash__sidebar">
			<div class="dash__sidebar-brand">
				<span class="dash__sidebar-brand-name">Lucoze</span>
			</div>
			{
				NAV.map((item) => (
					<button
						class:list={["dash__nav-item", item.active && "dash__nav-item--active"]}
						type="button"
					>
						<Icon name={item.icon} class="dash__nav-icon" />
						{item.label}
						{item.badge && <span class="dash__nav-badge">{item.badge}</span>}
					</button>
				))
			}
		</div>
		<div class="dash__main">
			<div class="dash__main-head">
				<span class="dash__main-title">Appointments</span>
				<span class="dash__main-sub">{mainSub}</span>
			</div>
			<div class="dash__metrics">
				{
					METRICS.map((m) => (
						<div class="dash__metric">
							<div class="dash__metric-label">{m.label}</div>
							<div class="dash__metric-value">{m.value}</div>
							<div class:list={["dash__metric-trend", m.trendDown && "dash__metric-trend--down"]}>
								{m.trend}
							</div>
						</div>
					))
				}
			</div>
			<table class="dash__table">
				<thead>
					<tr>
						<th>Time</th>
						<th>Patient</th>
						<th>With</th>
						<th>Status</th>
					</tr>
				</thead>
				<tbody>
					{
						ROWS.map((r) => (
							<tr>
								<td>{r.time}</td>
								<td>
									<span class="dash__avatar">{r.initials}</span>
									{r.patient}
								</td>
								<td>{r.with}</td>
								<td>
									<span class:list={["dash__pill", `dash__pill--${r.pill}`]}>{r.status}</span>
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</div>
</div>
