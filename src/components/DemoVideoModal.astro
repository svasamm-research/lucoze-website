---
/**
 * Demo video modal — plays /demo/pitch.{mp4,webm} in a native <video>
 * element inside a <dialog> overlay. Triggered by buttons with
 * data-open-demo-modal (optionally data-source for analytics).
 *
 * Native <video> brings: built-in controls, timer, fullscreen, accessibility.
 * On close: pause + reset currentTime — no src manipulation, no black-screen
 * on reopen.
 *
 * Closing methods: close button, backdrop click, Esc key.
 * Tracks "Demo Video Opened" + "Demo Video Closed" Plausible events.
 */
---

<dialog class="demo-modal" id="demoModal" aria-labelledby="demoModalTitle">
	<div class="demo-modal__frame">
		<div class="demo-modal__head">
			<h2 id="demoModalTitle" class="demo-modal__title">Lucoze — 90-second tour</h2>
			<button class="demo-modal__close" data-close-demo aria-label="Close demo">&times;</button>
		</div>
		<div class="demo-modal__player">
			<!--
			  preload="none" — the modal only opens on an explicit click (then JS
			  calls .play()), so the video should cost nothing on homepage load, not
			  even a metadata fetch. The poster covers the closed state. This keeps
			  the ~135 KB file off the critical path entirely (SEO audit 2026-07-20).
			  controls — browser-native bar with timer, play/pause, fullscreen, volume.
			  playsinline — keeps inline on iOS Safari (don't auto-go-fullscreen).
			-->
			<video
				class="demo-modal__video"
				preload="none"
				controls
				playsinline
				poster="/demo/pitch-poster.jpg"
			>
				<source src="/demo/pitch.mp4" type="video/mp4" />
				<source src="/demo/pitch.webm" type="video/webm" />
				Your browser doesn't support HTML5 video.
				<a href="/demo/pitch.mp4">Download the demo</a>.
			</video>
		</div>
	</div>
</dialog>

<style>
	.demo-modal {
		border: none;
		padding: 0;
		background: transparent;
		max-width: 100vw;
		max-height: 100vh;
		width: 100%;
		height: 100%;
		margin: 0;
		overflow: hidden;
	}

	.demo-modal::backdrop {
		background: rgba(15, 15, 15, 0.78);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
	}

	.demo-modal__frame {
		position: fixed;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: clamp(16px, 4vw, 48px);
		gap: 12px;
	}

	.demo-modal__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(1100px, 100%);
		color: #f4f3ee;
	}

	.demo-modal__title {
		font-family: var(--font-display, "Manrope"), system-ui, sans-serif;
		font-size: clamp(16px, 2vw, 20px);
		font-weight: 600;
		margin: 0;
		letter-spacing: -0.01em;
	}

	.demo-modal__close {
		appearance: none;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.18);
		color: #f4f3ee;
		width: 36px;
		height: 36px;
		border-radius: 999px;
		font-size: 24px;
		line-height: 1;
		cursor: pointer;
		display: grid;
		place-items: center;
		transition: background 120ms ease;
	}

	.demo-modal__close:hover,
	.demo-modal__close:focus-visible {
		background: rgba(255, 255, 255, 0.16);
		outline: none;
	}

	.demo-modal__player {
		position: relative;
		width: min(1100px, 100%);
		aspect-ratio: 16 / 9;
		border-radius: 12px;
		overflow: hidden;
		background: #000;
		box-shadow: 0 32px 80px rgba(0, 0, 0, 0.6);
	}

	.demo-modal__video {
		width: 100%;
		height: 100%;
		display: block;
		background: #000;
	}

	@media (max-width: 640px) {
		.demo-modal__head {
			padding: 0 4px;
		}
		.demo-modal__player {
			aspect-ratio: auto;
			height: 70vh;
		}
	}
</style>

<script>
	import { track } from "../lib/analytics";

	const modal = document.getElementById("demoModal") as HTMLDialogElement | null;
	const video = modal?.querySelector<HTMLVideoElement>(".demo-modal__video");
	const openers = document.querySelectorAll<HTMLElement>("[data-open-demo-modal]");

	function openModal(source: string) {
		if (!modal || !video) return;
		modal.showModal();
		// Always start from beginning when user re-opens
		video.currentTime = 0;
		// Play; ignore the promise rejection if browser blocks autoplay (user will hit play).
		video.play().catch(() => {});
		track("Demo Video Opened", { source });
	}

	function closeModal() {
		if (!modal || !video) return;
		video.pause();
		modal.close();
		track("Demo Video Closed");
	}

	openers.forEach((btn) => {
		btn.addEventListener("click", (e) => {
			e.preventDefault();
			openModal(btn.dataset.source || "unknown");
		});
	});

	// Native <dialog> emits "close" on Esc — make sure video pauses too.
	modal?.addEventListener("close", () => {
		video?.pause();
	});

	// Close button + backdrop click. Clicking the video itself should NOT close.
	modal?.addEventListener("click", (e) => {
		const target = e.target as HTMLElement;
		if (target.matches("[data-close-demo]") || target === modal) {
			closeModal();
		}
	});
</script>
