---
import Icon from "./Icon.astro";
---

<section class="hero" id="top" aria-labelledby="hero-heading">
	<div class="container">
		<h2 id="hero-heading" class="sr-only">Lucoze — Healthcare Management Software</h2>
		<div class="hero__grid">
			<div class="hero__copy">
				<span class="eyebrow-row">
					<span class="eyebrow-row__dot eyebrow-row__dot--pulse" aria-hidden="true"></span>
					Built for Indian clinics · Data hosted in Mumbai
				</span>
				<h1>
					Run your <em>entire clinic</em> on one platform.
				</h1>
				<p class="hero__lead">
					Patient records, appointments, billing, lab, and pharmacy — together. Built for the way
					Indian clinics actually work. Live in 14 days, not six months.
				</p>
				<div class="hero__actions">
					<a href="/in/signup/" class="btn btn--accent btn--lg">
						Start 14-day free trial
						<Icon name="arrow" size={16} class="btn__arrow" />
					</a>
					<a href="/in/contact/" class="btn btn--ghost btn--lg">
						<Icon name="play" size={14} />
						Watch 90-sec demo
					</a>
				</div>
				<div class="hero__sub-trust">
					<Icon name="check-circle" />
					No credit card · Cancel anytime · 6 months free for the first 10 design-partner clinics
				</div>
			</div>

			<div class="hero__visual" aria-label="Live product preview">
				<!-- Placeholder until DashboardMock React island ships in Phase C -->
				<div class="dash dash-placeholder">
					<div class="dash__chrome">
						<span class="dash__dot"></span>
						<span class="dash__dot"></span>
						<span class="dash__dot"></span>
						<span class="dash__chrome-title">lucoze.com/dashboard</span>
					</div>
					<div class="dash-placeholder__body">
						<div class="dash-placeholder__row dash-placeholder__row--head">
							Today's appointments
						</div>
						<div class="dash-placeholder__row">
							<span class="dash__avatar">PS</span> Priya S. · Dr. Mehta · 10:00
							<span class="dash__pill dash__pill--ok">Checked in</span>
						</div>
						<div class="dash-placeholder__row">
							<span class="dash__avatar">AK</span> Aniket K. · Dr. Reddy · 10:30
							<span class="dash__pill dash__pill--warn">Late</span>
						</div>
						<div class="dash-placeholder__row">
							<span class="dash__avatar">RG</span> Riya G. · Dr. Sen · 11:00
							<span class="dash__pill dash__pill--info">Confirmed</span>
						</div>
						<div class="dash-placeholder__row">
							<span class="dash__avatar">VP</span> Vinod P. · Dr. Mehta · 11:30
							<span class="dash__pill dash__pill--info">Confirmed</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	/* Placeholder dashboard styling — covers chrome + a simple appointments
	   list. Replaced by the full DashboardMock React island in Phase C. */
	.dash-placeholder {
		min-height: 460px;
		display: flex;
		flex-direction: column;
	}
	.dash-placeholder__body {
		padding: var(--s-5) var(--s-6);
		display: flex;
		flex-direction: column;
		gap: var(--s-3);
	}
	.dash-placeholder__row {
		display: flex;
		align-items: center;
		gap: var(--s-3);
		padding: var(--s-3) 0;
		border-bottom: 1px solid var(--border-light);
		font-size: var(--t-sm);
		color: var(--ink-soft);
	}
	.dash-placeholder__row:last-child {
		border-bottom: none;
	}
	.dash-placeholder__row .dash__pill {
		margin-left: auto;
	}
	.dash-placeholder__row--head {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--t-md);
		color: var(--ink);
		border-bottom: 1px solid var(--border);
		padding-bottom: var(--s-4);
	}
</style>
