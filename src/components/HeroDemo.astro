---
import Icon from "./Icon.astro";
import Screenshot from "./Screenshot.astro";
import DemoVideoModal from "./DemoVideoModal.astro";
---

<section class="hero" id="top" aria-labelledby="hero-heading">
	<div class="container">
		<h2 id="hero-heading" class="sr-only">Lucoze — Healthcare Management Software</h2>
		<div class="hero__grid">
			<div class="hero__copy">
				<span class="eyebrow-row">
					<span class="eyebrow-row__dot eyebrow-row__dot--pulse" aria-hidden="true"></span>
					For Indian hospitals &amp; clinics · Data hosted in India
				</span>
				{
					/* The practice-type word cycles (clinic → hospital → …) to show the
				    product spans more than single-doctor clinics. The animated list is
				    aria-hidden and a stable sr-only word carries the accessible name,
				    so assistive tech reads one fixed sentence. Pure CSS — nothing on
				    the LCP path. */
				}
				<h1>
					Run your <em
						>entire <span class="rotator">
							<span class="rotator__sizer" aria-hidden="true">multispecialty</span>
							<span class="rotator__list" aria-hidden="true">
								<span>hospital</span>
								<span>multispecialty</span>
								<span>nursing home</span>
								<span>polyclinic</span>
								<span>clinic</span>
							</span>
							<span class="sr-only">hospital</span>
						</span></em
					> on one platform.
				</h1>
				<p class="hero__lead">
					Every department — OPD, IPD, OT, lab, pharmacy, billing — on one platform. ABDM-ready,
					data hosted in India, and you move off your old system without a single day of downtime.
				</p>
				<div class="hero__actions">
					<a href="/in/demo/" class="btn btn--accent btn--lg">
						Book a demo
						<Icon name="arrow" size={16} class="btn__arrow" />
					</a>
					<button
						type="button"
						class="btn btn--ghost btn--lg"
						data-open-demo-modal
						data-source="hero"
					>
						<Icon name="play" size={14} />
						Watch Promo
					</button>
				</div>
				<div class="hero__sub-trust">
					<Icon name="check-circle" />
					No credit card to start · Data hosted in India · 6 months free for the first 10 design partners
				</div>
			</div>

			<div class="hero__visual" aria-label="Live product preview">
				<Screenshot
					name="front-office"
					alt="Lucoze front office dashboard — OPD queue, appointments and check-in for an Indian hospital"
					loading="eager"
				/>
			</div>
		</div>
	</div>

	<DemoVideoModal />
</section>
