---
import VaultMark from "./VaultMark.astro";

interface Props {
	size?: number;
	href?: string;
	class?: string;
}

const { size = 32, href = "/in/", class: cls = "" } = Astro.props;
---

<a href={href} class:list={["logo", cls]} aria-label="Lucoze home">
	<VaultMark size={size} />
	<span class="logo__wordmark">Lucoze</span>
</a>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 14px;
		color: var(--ink);
		text-decoration: none;
	}
	.logo__wordmark {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--t-xl);
		letter-spacing: -0.03em;
		line-height: 1;
		color: inherit;
	}
</style>
