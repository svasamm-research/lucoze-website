---
import Icon from "./Icon.astro";

const items = [
	{ icon: "cloud", label: "Data hosted in Mumbai" },
	{ icon: "shield", label: "DPDP 2023 compliant" },
	{ icon: "check", label: "ABDM-ready · ABHA + HPR" },
	{ icon: "spark", label: "Live in 14 days" },
	{ icon: "rupee", label: "GST-compliant invoicing" },
];
---

<section class="trust-strip" aria-label="Trust signals">
	<div class="container">
		<div class="trust-strip__inner">
			{
				items.map((it, i) => (
					<>
						<span class="trust-strip__item">
							<Icon name={it.icon} class="trust-strip__icon" />
							{it.label}
						</span>
						{i < items.length - 1 && <span class="trust-strip__divider" aria-hidden="true" />}
					</>
				))
			}
		</div>
	</div>
</section>
