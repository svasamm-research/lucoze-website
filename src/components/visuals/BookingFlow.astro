---
/** Interactive booking-flow walkthrough. All 4 stages render at build
 *  time; vanilla-JS at the bottom toggles which stage is visible when
 *  the visitor clicks a step card. */
interface Stage {
	heading: string;
	body: string;
	cards: [string, string][];
}

const STEPS: { n: string; title: string; blurb: string; stage: Stage }[] = [
	{
		n: "01",
		title: "Department",
		blurb: "Patient picks where they need to go.",
		stage: {
			heading: "1. Pick a department",
			body: "Patient knows what they need before they know who they need to see. Department is the first question — not name.",
			cards: [
				["General Medicine", "18 slots today"],
				["Cardiology", "6 slots today"],
				["Dermatology", "11 slots today"],
				["Dental", "4 chairs free"],
			],
		},
	},
	{
		n: "02",
		title: "Doctor",
		blurb: "Filter by availability + slot fit.",
		stage: {
			heading: "2. Pick a doctor",
			body: "Showing only doctors with availability today. The patient sees the timing window that matters to them — not a directory page.",
			cards: [
				["Dr S. Sen · OPD", "Next slot 10:30"],
				["Dr P. Chatterjee · Cardio", "Next slot 11:00"],
				["Dr R. Mukherjee · OPD", "Fully booked today"],
			],
		},
	},
	{
		n: "03",
		title: "Slot",
		blurb: "Real availability, no overbooking.",
		stage: {
			heading: "3. Pick a slot",
			body: "Real availability, not best-guesses. Doctor's blocks for procedures stay reserved; walk-ins don't appear here.",
			cards: [
				["10:30 AM", "Dr Sen · 15 min"],
				["11:00 AM", "Dr Sen · 15 min"],
				["11:30 AM", "Dr Sen · 15 min"],
				["3:00 PM", "Dr Sen · 30 min"],
			],
		},
	},
	{
		n: "04",
		title: "Patient",
		blurb: "Name + phone, last — once committed.",
		stage: {
			heading: "4. Patient details",
			body: "Now — not three screens ago. Patient is committed to a slot; they finish the form. Returning patients skip it entirely.",
			cards: [
				["Phone number", "+91 ·····"],
				["Name (new patients only)", "Type to begin"],
				["Confirmation", "WhatsApp + SMS"],
			],
		},
	},
];
---

<div class="booking">
	<div class="booking__steps" role="tablist" aria-label="Booking flow steps">
		{
			STEPS.map((s, i) => (
				<button
					type="button"
					role="tab"
					aria-selected={i === 0}
					aria-controls={`booking-stage-${s.n}`}
					id={`booking-tab-${s.n}`}
					data-booking-step={s.n}
					class:list={["booking__step", i === 0 && "booking__step--active"]}
				>
					<span class="booking__step-num">Step {s.n}</span>
					<span class="booking__step-title">{s.title}</span>
					<span class="booking__step-blurb">{s.blurb}</span>
				</button>
			))
		}
	</div>

	{
		STEPS.map((s, i) => (
			<div
				class="booking__stage"
				role="tabpanel"
				id={`booking-stage-${s.n}`}
				aria-labelledby={`booking-tab-${s.n}`}
				data-booking-stage={s.n}
				hidden={i !== 0}
			>
				<h3>{s.stage.heading}</h3>
				<p>{s.stage.body}</p>
				<div class="booking__cards">
					{s.stage.cards.map((c) => (
						<div class="booking__chip">
							<div class="booking__chip-head">{c[0]}</div>
							<div class="booking__chip-sub">{c[1]}</div>
						</div>
					))}
				</div>
			</div>
		))
	}
</div>

<script>
	import { track } from "../../lib/analytics";
	// BookingFlow stepper — click a step, swap which stage panel is visible.
	// All 4 stages are pre-rendered with the hidden attribute on 3 of them.
	document.querySelectorAll("[data-booking-step]").forEach((btn) => {
		btn.addEventListener("click", () => {
			const n = btn.getAttribute("data-booking-step");
			document.querySelectorAll("[data-booking-step]").forEach((b) => {
				const active = b === btn;
				b.classList.toggle("booking__step--active", active);
				b.setAttribute("aria-selected", active ? "true" : "false");
			});
			document.querySelectorAll("[data-booking-stage]").forEach((stage) => {
				(stage as HTMLElement).hidden = stage.getAttribute("data-booking-stage") !== n;
			});
			if (n) track("Booking Step Click", { step: n });
		});
	});
</script>
