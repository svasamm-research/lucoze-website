---
const MEMBERS = [
	{ who: "Rajiv Banerjee", role: "head", age: 58, flag: "Hypertension" },
	{ who: "Sucheta Banerjee", role: "spouse", age: 54, flag: "Diabetic" },
	{ who: "Aniket Banerjee", role: "child", age: 19, flag: null },
];
---

<div style="display: flex; flex-direction: column; gap: 8px;">
	<div
		style="font-size: 11px; font-weight: 700; color: var(--muted); letter-spacing: 0.04em; text-transform: uppercase;"
	>
		Banerjee family
	</div>
	{
		MEMBERS.map((p) => (
			<div style="padding: 12px; background: var(--paper); border-radius: 8px; border: 1px solid var(--border); display: flex; align-items: center; gap: 12px;">
				<div style="width: 36px; height: 36px; border-radius: 50%; background: var(--primary-light); color: var(--primary-deep); display: grid; place-items: center; font-weight: 700; font-size: 13px;">
					{p.who
						.split(" ")
						.map((s) => s[0])
						.join("")}
				</div>
				<div>
					<div style="font-size: 13px; font-weight: 600;">{p.who}</div>
					<div style="font-size: 11px; color: var(--muted);">
						{p.role} · {p.age}
					</div>
				</div>
				{p.flag && (
					<span style="margin-left: auto; padding: 3px 10px; background: var(--primary-light); color: var(--primary-deep); border-radius: 12px; font-size: 11px; font-weight: 600;">
						{p.flag}
					</span>
				)}
			</div>
		))
	}
	<div
		style="padding: 8px 12px; background: var(--cream); border-radius: 8px; font-size: 11px; color: var(--muted); text-align: center; font-style: italic;"
	>
		Shared family billing · Independent records · One recall calendar
	</div>
</div>
