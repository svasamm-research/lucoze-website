---
const CARDS: [string, string, string][] = [
	["Today's revenue", "₹41,200", "+18%"],
	["UPI / Card / Cash", "58 / 22 / 20%", ""],
	["Pending receivables", "₹18,400", "12 invoices"],
	["Branch P&L (this month)", "₹4.2L profit", "Salt Lake"],
];
---

<div style="display: flex; flex-direction: column; gap: 10px;">
	{
		CARDS.map(([k, v, s]) => (
			<div style="padding: 10px; background: var(--paper); border-radius: 8px; border: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
				<div>
					<div style="font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700;">
						{k}
					</div>
					<div style="font-family: var(--font-display); font-weight: 700; font-size: 18px; margin-top: 3px;">
						{v}
					</div>
				</div>
				{s && <div style="font-size: 11px; color: var(--success); font-weight: 600;">{s}</div>}
			</div>
		))
	}
</div>
