---
const LINES: [string, string, string, string][] = [
	["Total cholesterol", "218", "< 200", "H"],
	["LDL", "138", "< 100", "H"],
	["HDL", "42", "> 40", "—"],
	["Triglycerides", "186", "< 150", "H"],
];
---

<div style="background: var(--cream); border-radius: 8px; padding: 14px; font-size: 12px;">
	<div
		style="display: flex; justify-content: space-between; padding-bottom: 8px; border-bottom: 1px solid var(--border);"
	>
		<div>
			<div style="font-weight: 700; font-size: 14px;">Lipid Panel</div>
			<div style="font-size: 11px; color: var(--muted); font-family: var(--font-mono);">
				LAB-4421 · Rajiv Banerjee
			</div>
		</div>
		<div
			style="padding: 3px 10px; background: var(--success-bg); color: var(--success); border-radius: 12px; font-size: 11px; font-weight: 600; height: fit-content;"
		>
			Signed
		</div>
	</div>
	{
		LINES.map(([k, v, ref, flag]) => (
			<div style="display: grid; grid-template-columns: 1.5fr 1fr 1fr 30px; padding: 6px 0; border-bottom: 1px dashed var(--border-light); font-size: 12px;">
				<div>{k}</div>
				<div style="font-family: var(--font-mono); font-weight: 600;">{v}</div>
				<div style="font-family: var(--font-mono); color: var(--muted); font-size: 11px;">
					{ref}
				</div>
				<div
					style={`text-align: right; color: ${flag === "H" ? "var(--error)" : "var(--muted)"}; font-weight: 700;`}
				>
					{flag}
				</div>
			</div>
		))
	}
	<div style="margin-top: 8px; font-size: 10px; color: var(--muted); font-style: italic;">
		Signed by Dr. P. Sarkar, MD (Path) · MCI 19488 · NABL accredited
	</div>
</div>
