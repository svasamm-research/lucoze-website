---
const LINES: [string, string][] = [
	["Basic", "₹62,000"],
	["HRA", "₹24,000"],
	["Doctor incentive", "₹18,400"],
	["TDS", "-₹4,820"],
	["PF", "-₹7,440"],
	["ESI", "-₹544"],
];
---

<div style="background: var(--cream); border-radius: 8px; padding: 14px; font-size: 12px;">
	<div style="font-weight: 700; margin-bottom: 6px;">Payslip · April 2026</div>
	<div
		style="font-size: 11px; color: var(--muted); margin-bottom: 10px; font-family: var(--font-mono);"
	>
		Dr S. Sen · OPD lead
	</div>
	{
		LINES.map(([k, v]) => (
			<div style="display: flex; justify-content: space-between; padding: 5px 0; border-bottom: 1px dashed var(--border-light); font-size: 12px;">
				<span>{k}</span>
				<span
					style={`font-family: var(--font-mono); font-weight: 600; color: ${v.startsWith("-") ? "var(--error)" : "var(--ink-soft)"};`}
				>
					{v}
				</span>
			</div>
		))
	}
	<div
		style="display: flex; justify-content: space-between; margin-top: 8px; padding-top: 8px; border-top: 2px solid var(--ink); font-weight: 700;"
	>
		<span>Net pay</span>
		<span style="font-family: var(--font-mono); color: var(--primary);">₹91,596</span>
	</div>
</div>
