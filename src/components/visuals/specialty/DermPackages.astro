---
import Icon from "../../Icon.astro";

type Slot = "done" | "now" | "num";
const PACKAGES: {
	name: string;
	amount: string;
	desc: string;
	sessions: { state: Slot; label?: string }[];
	photos: (string | null)[];
	calendar: string;
}[] = [
	{
		name: "A. Roy Choudhury",
		amount: "₹45,000",
		desc: "Laser hair removal · 6 sessions",
		sessions: [
			{ state: "done" },
			{ state: "done" },
			{ state: "done" },
			{ state: "now" },
			{ state: "num", label: "5" },
			{ state: "num", label: "6" },
		],
		photos: ["pre", "wk4", "wk12"],
		calendar: "12 June · Dr Bose",
	},
	{
		name: "Karan Mohanty",
		amount: "₹18,000",
		desc: "Botox glabellar · 3 visits",
		sessions: [{ state: "done" }, { state: "done" }, { state: "num", label: "3" }],
		photos: ["pre", "wk1", null],
		calendar: "30 Aug · Dr Bose",
	},
	{
		name: "Rina Saha",
		amount: "₹9,800",
		desc: "Acne management · 4 visits + RX",
		sessions: [
			{ state: "done" },
			{ state: "now" },
			{ state: "num", label: "3" },
			{ state: "num", label: "4" },
		],
		photos: ["pre", null, null],
		calendar: "5 Jun · Dr Ghosh",
	},
];
---

<div class="viz derm">
	<div class="viz__chrome">
		<span class="viz__chrome-title">Guwahati derm · 3 active packages</span>
		<span class="viz__chrome-meta">Procedure revenue MTD · ₹3.8L</span>
	</div>
	<div class="derm__grid">
		{
			PACKAGES.map((p) => (
				<div class="derm__card">
					<div class="derm__head">
						<div class="derm__name">{p.name}</div>
						<div class="derm__amount">{p.amount}</div>
					</div>
					<div class="derm__desc">{p.desc}</div>
					<div class="derm__sessions">
						{p.sessions.map((s) => (
							<div class:list={["derm__sess", `derm__sess--${s.state}`]}>
								{s.state === "done" && <Icon name="check" size={12} />}
								{s.state === "now" && (
									<span style="width:5px;height:5px;border-radius:50%;background:#fff;display:inline-block;" />
								)}
								{s.state === "num" && s.label}
							</div>
						))}
					</div>
					<div class="derm__photos">
						{p.photos.map((label) => (
							<div class:list={["derm__photo", !label && "derm__photo--empty"]}>
								<span>{label || "—"}</span>
							</div>
						))}
					</div>
					<div class="derm__cal">
						<Icon name="calendar" size={12} />
						<span>{p.calendar}</span>
					</div>
				</div>
			))
		}
	</div>
</div>

<style>
	.derm__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--s-4);
		padding: var(--s-5) var(--s-6);
		background: var(--paper);
	}
	@media (max-width: 880px) {
		.derm__grid {
			grid-template-columns: 1fr;
		}
	}
	.derm__card {
		background: var(--cream);
		border-radius: var(--r-md);
		padding: var(--s-4);
		display: flex;
		flex-direction: column;
		gap: var(--s-3);
		border: 1px solid var(--border-light);
	}
	.derm__head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
	}
	.derm__name {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 14px;
		color: var(--ink);
	}
	.derm__amount {
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 700;
		color: var(--primary);
	}
	.derm__desc {
		font-size: 11px;
		color: var(--muted);
	}
	.derm__sessions {
		display: flex;
		gap: 4px;
	}
	.derm__sess {
		flex: 1;
		height: 26px;
		border-radius: 4px;
		display: grid;
		place-items: center;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 700;
	}
	.derm__sess--done {
		background: var(--success);
		color: var(--white);
	}
	.derm__sess--now {
		background: var(--primary);
		color: var(--white);
	}
	.derm__sess--num {
		background: var(--paper);
		border: 1px solid var(--border);
		color: var(--muted);
	}
	.derm__photos {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 6px;
	}
	.derm__photo {
		aspect-ratio: 1;
		background: var(--paper);
		border-radius: var(--r-sm);
		display: grid;
		place-items: center;
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--ink-soft);
		border: 1px solid var(--border-light);
	}
	.derm__photo--empty {
		border: 1px dashed var(--border);
		color: var(--light);
	}
	.derm__cal {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 11px;
		color: var(--muted);
		font-family: var(--font-mono);
		padding: 6px 8px;
		background: var(--paper);
		border-radius: var(--r-sm);
		width: fit-content;
	}
</style>
