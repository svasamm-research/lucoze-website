---
const WARDS: {
	name: string;
	beds: { code: string; patient?: string; status?: string; state: "occ" | "free" | "clean" }[];
}[] = [
	{
		name: "General Ward · A",
		beds: [
			{ code: "A01", patient: "R. Banerjee", status: "D3 · Stable", state: "occ" },
			{ code: "A02", patient: "S. Patnaik", status: "D1 · Post-op", state: "occ" },
			{ code: "A03", status: "Available", state: "free" },
			{ code: "A04", patient: "M. Nayak", status: "D5 · Recovery", state: "occ" },
			{ code: "A05", status: "Cleaning", state: "clean" },
			{ code: "A06", patient: "P. Singh", status: "D2 · Stable", state: "occ" },
			{ code: "A07", status: "Available", state: "free" },
			{ code: "A08", patient: "K. Sharma", status: "D1 · New", state: "occ" },
		],
	},
	{
		name: "ICU",
		beds: [
			{ code: "I01", patient: "L. Mishra", status: "D2 · Critical", state: "occ" },
			{ code: "I02", patient: "B. Pradhan", status: "D4 · Stable", state: "occ" },
			{ code: "I03", status: "Available", state: "free" },
			{ code: "I04", patient: "V. Devi", status: "D1 · Watch", state: "occ" },
		],
	},
	{
		name: "Maternity",
		beds: [
			{ code: "M01", patient: "A. Devi", status: "D1 · Post-delivery", state: "occ" },
			{ code: "M02", patient: "S. Kumari", status: "D2 · Stable", state: "occ" },
			{ code: "M03", status: "Available", state: "free" },
			{ code: "M04", status: "Available", state: "free" },
		],
	},
];

const OT: { time: string; proc: string; doc: string; pill?: "in" | "next" }[] = [
	{ time: "09:00", proc: "Lap chole", doc: "Dr Mishra · 90 min", pill: "in" },
	{ time: "11:00", proc: "Hernia repair", doc: "Dr Sinha · 60 min", pill: "next" },
	{ time: "12:30", proc: "C-section", doc: "Dr Roy · 75 min" },
	{ time: "14:30", proc: "Ortho · Knee scope", doc: "Dr Khan · 90 min" },
];
---

<div class="viz hospbed">
	<div class="viz__chrome">
		<span class="viz__chrome-title">50-bed hospital · 18 May · Live</span>
		<span class="viz__chrome-meta">Occupied 10 · Free 5 · Cleaning 1</span>
	</div>
	<div class="hospbed__body">
		<div class="hospbed__wards">
			{
				WARDS.map((w) => (
					<div class="hospbed__ward">
						<div class="hospbed__ward-name">{w.name}</div>
						<div class="hospbed__grid">
							{w.beds.map((b) => (
								<div class:list={["hospbed__bed", `hospbed__bed--${b.state}`]}>
									<div class="hospbed__bed-code">{b.code}</div>
									{b.patient && <div class="hospbed__bed-patient">{b.patient}</div>}
									{b.status && <div class="hospbed__bed-status">{b.status}</div>}
								</div>
							))}
						</div>
					</div>
				))
			}
		</div>
		<div class="hospbed__ot">
			<div class="hospbed__ot-head">OT schedule · today</div>
			{
				OT.map((s) => (
					<div class:list={["hospbed__ot-row", s.pill === "in" && "hospbed__ot-row--active"]}>
						<span class="hospbed__ot-time">{s.time}</span>
						<div class="hospbed__ot-body">
							<div class="hospbed__ot-proc">{s.proc}</div>
							<div class="hospbed__ot-doc">{s.doc}</div>
						</div>
						{s.pill === "in" && <span class="hospbed__ot-pill hospbed__ot-pill--in">In OT</span>}
						{s.pill === "next" && <span class="hospbed__ot-pill">Next</span>}
					</div>
				))
			}
		</div>
	</div>
</div>

<style>
	.hospbed__body {
		display: grid;
		grid-template-columns: 1.6fr 1fr;
		background: var(--paper);
	}
	.hospbed__wards {
		padding: var(--s-5) var(--s-6);
		display: flex;
		flex-direction: column;
		gap: var(--s-5);
		border-right: 1px solid var(--border-light);
	}
	.hospbed__ward-name {
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 8px;
	}
	.hospbed__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 8px;
	}
	.hospbed__bed {
		border-radius: var(--r-sm);
		padding: 8px 10px;
		min-height: 64px;
		font-family: var(--font-mono);
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.hospbed__bed--occ {
		background: var(--ink);
		color: var(--cream);
	}
	.hospbed__bed--free {
		background: transparent;
		border: 1.5px dashed var(--border);
		color: var(--muted);
	}
	.hospbed__bed--clean {
		background: var(--warning-bg);
		border: 1.5px dashed var(--warning);
		color: var(--warning);
	}
	.hospbed__bed-code {
		font-size: 9px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgba(244, 243, 238, 0.5);
		font-weight: 700;
	}
	.hospbed__bed--free .hospbed__bed-code,
	.hospbed__bed--clean .hospbed__bed-code {
		color: currentColor;
	}
	.hospbed__bed-patient {
		font-size: 12px;
		font-weight: 700;
		color: var(--cream);
		font-family: var(--font-body);
	}
	.hospbed__bed-status {
		font-size: 10px;
		color: rgba(244, 243, 238, 0.6);
	}
	.hospbed__bed--free .hospbed__bed-status,
	.hospbed__bed--clean .hospbed__bed-status {
		color: currentColor;
		font-family: var(--font-body);
		font-style: italic;
	}
	.hospbed__ot {
		padding: var(--s-5) var(--s-6);
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.hospbed__ot-head {
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: 6px;
	}
	.hospbed__ot-row {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 10px 12px;
		border-radius: var(--r-sm);
		border-left: 3px solid transparent;
	}
	.hospbed__ot-row--active {
		border-left-color: var(--primary);
	}
	.hospbed__ot-time {
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 700;
		color: var(--ink);
	}
	.hospbed__ot-body {
		flex: 1;
	}
	.hospbed__ot-proc {
		font-size: 13px;
		font-weight: 600;
		color: var(--ink);
	}
	.hospbed__ot-doc {
		font-size: 11px;
		color: var(--muted);
	}
	.hospbed__ot-pill {
		padding: 2px 9px;
		border-radius: var(--r-full);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		background: var(--cream);
		color: var(--muted);
	}
	.hospbed__ot-pill--in {
		background: var(--primary);
		color: var(--white);
	}
	@media (max-width: 880px) {
		.hospbed__body {
			grid-template-columns: 1fr;
		}
		.hospbed__wards {
			border-right: none;
			border-bottom: 1px solid var(--border-light);
		}
		.hospbed__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
