---
type IvfEvent = { day: number; kind: "stim" | "usg" | "opu" | "et" | "beta"; label?: string };

const PATIENTS: {
	name: string;
	id: string;
	events: IvfEvent[];
	status: string;
	sub: string;
}[] = [
	{
		name: "S. Choudhury",
		id: "IVF-441",
		events: [
			{ day: 1, kind: "stim", label: "1" },
			{ day: 3, kind: "usg", label: "3" },
			{ day: 5, kind: "stim", label: "5" },
			{ day: 7, kind: "usg", label: "7" },
			{ day: 9, kind: "usg", label: "9" },
			{ day: 11, kind: "opu", label: "11" },
			{ day: 14, kind: "et", label: "14" },
			{ day: 21, kind: "beta", label: "21" },
		],
		status: "OPU today",
		sub: "₹1.2L · 3/12",
	},
	{
		name: "R. Sahoo",
		id: "IVF-442",
		events: [
			{ day: 1, kind: "stim", label: "1" },
			{ day: 3, kind: "usg", label: "3" },
			{ day: 5, kind: "stim", label: "5" },
			{ day: 7, kind: "usg", label: "7" },
			{ day: 9, kind: "usg", label: "9" },
			{ day: 11, kind: "opu", label: "11" },
			{ day: 14, kind: "et", label: "14" },
			{ day: 21, kind: "beta", label: "21" },
		],
		status: "ET today",
		sub: "A · 4 embryos · ₹3.6L paid",
	},
	{
		name: "P. Agarwal",
		id: "IVF-443",
		events: [
			{ day: 1, kind: "stim", label: "1" },
			{ day: 3, kind: "usg", label: "3" },
			{ day: 5, kind: "stim", label: "5" },
			{ day: 7, kind: "usg", label: "7" },
			{ day: 9, kind: "usg", label: "9" },
			{ day: 11, kind: "opu", label: "11" },
			{ day: 14, kind: "et", label: "14" },
			{ day: 17, kind: "stim" },
			{ day: 21, kind: "beta", label: "21" },
		],
		status: "Day 3 post-ET",
		sub: "₹95k · pending",
	},
	{
		name: "M. Pathak",
		id: "IVF-444",
		events: [
			{ day: 1, kind: "stim", label: "1" },
			{ day: 3, kind: "usg", label: "3" },
			{ day: 5, kind: "stim", label: "5" },
			{ day: 7, kind: "usg", label: "7" },
			{ day: 9, kind: "usg", label: "9" },
			{ day: 11, kind: "opu", label: "11" },
			{ day: 14, kind: "et", label: "14" },
			{ day: 21, kind: "beta", label: "21" },
		],
		status: "Stim phase",
		sub: "₹2.1L · 1/12",
	},
];

const KIND_COLORS: Record<IvfEvent["kind"], string> = {
	stim: "#c15f3c",
	usg: "#8a857e",
	opu: "#3f6a8e",
	et: "#3d7e54",
	beta: "#6b4488",
};

const LEGEND: { kind: IvfEvent["kind"]; label: string }[] = [
	{ kind: "stim", label: "Stim" },
	{ kind: "usg", label: "USG / Hormone" },
	{ kind: "opu", label: "OPU" },
	{ kind: "et", label: "ET" },
	{ kind: "beta", label: "Beta hCG" },
];
---

<div class="viz ivf">
	<div class="viz__chrome">
		<span class="viz__chrome-title">Bhubaneswar IVF · 14 active cycles</span>
		<span class="viz__chrome-meta">May cohort · 31% success rolling 3-mo</span>
	</div>
	<div class="ivf__body">
		<div class="ivf__legend">
			{
				LEGEND.map((l) => (
					<span class="ivf__legend-item">
						<span class="ivf__legend-dot" style={`background: ${KIND_COLORS[l.kind]};`} />
						{l.label}
					</span>
				))
			}
		</div>
		{
			PATIENTS.map((p) => (
				<div class="ivf__row">
					<div class="ivf__who">
						<div class="ivf__name">{p.name}</div>
						<div class="ivf__id">{p.id}</div>
					</div>
					<div class="ivf__track">
						{Array.from({ length: 21 }, (_, i) => i + 1).map((d) => {
							const e = p.events.find((x) => x.day === d);
							return (
								<div class="ivf__cell">
									{e ? (
										<span
											class="ivf__event"
											style={`background: ${KIND_COLORS[e.kind]}; color: ${e.kind === "usg" ? "var(--ink)" : "#fff"};`}
										>
											{e.label || ""}
										</span>
									) : null}
								</div>
							);
						})}
					</div>
					<div class="ivf__status">
						<div class="ivf__status-label">{p.status}</div>
						<div class="ivf__status-sub">{p.sub}</div>
					</div>
				</div>
			))
		}
	</div>
</div>

<style>
	.ivf__body {
		padding: var(--s-5) var(--s-6);
		background: var(--paper);
	}
	.ivf__legend {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-5);
		padding-bottom: var(--s-4);
		border-bottom: 1px solid var(--border-light);
		margin-bottom: var(--s-4);
		font-size: 11px;
		color: var(--ink-soft);
		font-family: var(--font-mono);
	}
	.ivf__legend-item {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}
	.ivf__legend-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
	}
	.ivf__row {
		display: grid;
		grid-template-columns: 130px 1fr 130px;
		align-items: center;
		gap: 16px;
		padding: 10px 0;
	}
	.ivf__name {
		font-size: 13px;
		font-weight: 700;
		color: var(--ink);
	}
	.ivf__id {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--muted);
	}
	.ivf__track {
		display: grid;
		grid-template-columns: repeat(21, 1fr);
		gap: 3px;
		height: 28px;
		position: relative;
	}
	.ivf__track::before {
		content: "";
		position: absolute;
		inset: 0;
		background: var(--primary-light);
		opacity: 0.25;
		border-radius: 4px;
		z-index: 0;
	}
	.ivf__cell {
		position: relative;
		z-index: 1;
		display: grid;
		place-items: center;
	}
	.ivf__event {
		width: 100%;
		height: 100%;
		border-radius: 3px;
		display: grid;
		place-items: center;
		font-family: var(--font-mono);
		font-size: 10px;
		font-weight: 700;
	}
	.ivf__status-label {
		font-size: 12px;
		font-weight: 700;
		color: var(--ink);
	}
	.ivf__status-sub {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--muted);
	}
	@media (max-width: 720px) {
		.ivf__row {
			grid-template-columns: 1fr;
			gap: 8px;
		}
	}
</style>
