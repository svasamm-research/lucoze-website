---
/**
 * Base.astro — site-wide layout for the Vault redesign (2026).
 * Wraps every page with chrome (Nav + Footer), <head> meta, fonts,
 * favicon, OG/Twitter cards, and optional Plausible analytics.
 */
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/sections.css";
import "../styles/subpages.css";
import Nav from "../components/redesign/Nav.astro";
import Footer from "../components/redesign/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";
import WhatsAppFab from "../components/WhatsAppFab.astro";
import { OG_PAGES } from "../lib/og-pages";
import { PHONE, SALES_EMAIL } from "../data/contact";

// GA4 loads only when PUBLIC_GA_ID is set (prod build env) — keeps UAT/local
// out of the analytics property. Consent Mode defaults to denied; the cookie
// banner flips it to granted on accept. Plausible stays independent (cookieless).
const GA_ID = import.meta.env.PUBLIC_GA_ID as string | undefined;

interface Props {
	title: string;
	description: string;
	canonical?: string;
	activeLink?: string;
	ogImage?: string;
}

const {
	title,
	description,
	canonical = Astro.url.href,
	ogImage = "/og-default.png",
	activeLink = "",
} = Astro.props;

const siteUrl = "https://lucoze.com";
const fullTitle = title.toLowerCase().includes("lucoze") ? title : `${title} | Lucoze`;

// OG image resolution: an explicit `ogImage` prop wins (e.g. a page that wants
// a specific screenshot); otherwise the branded auto-generated card for this
// route (/open-graph/<route>.png); otherwise the static default.
// Set USE_GENERATED_OG = false to revert the whole site to the static default.
const USE_GENERATED_OG = true;
const OG_DEFAULT = "/og-default.png";
const ogRoute = Astro.url.pathname.replace(/^\/+|\/+$/g, "");
const ogPath =
	ogImage !== OG_DEFAULT
		? ogImage
		: USE_GENERATED_OG && OG_PAGES[ogRoute]
			? `/open-graph/${ogRoute}.png`
			: ogImage;
const ogSrc = ogPath.startsWith("http") ? ogPath : `${siteUrl}${ogPath}`;

// Site-wide entity graph. Emitted on every page so Google/LLMs can resolve
// "Lucoze" (brand) → Svasamm Research Pvt. Ltd. (legal entity) with a founder
// node for corroboration. The homepage adds a page-specific FAQPage on top.
const orgLd = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"@id": `${siteUrl}/#organization`,
	name: "Lucoze",
	legalName: "Svasamm Research Pvt. Ltd.",
	// "Lucoze" is a coined name with no established web presence and is easily
	// confused with similarly spelled consumer brands. Stating the category
	// inline gives search engines and LLMs an unambiguous anchor for the entity.
	description:
		"Lucoze is healthcare management software (HMS/EMR) for clinics and hospitals in India, built by Svasamm Research Pvt. Ltd. It is business software for healthcare providers, not a consumer product or a healthcare provider itself.",
	foundingDate: "2024",
	url: siteUrl,
	logo: `${siteUrl}/favicon-vault-32.png`,
	sameAs: [
		"https://www.linkedin.com/company/113023331/",
		"https://www.crunchbase.com/organization/lucoze",
		"https://x.com/lucozehq",
	],
	telephone: PHONE,
	address: {
		"@type": "PostalAddress",
		addressLocality: "Konnagar",
		addressRegion: "West Bengal",
		postalCode: "712246",
		addressCountry: "IN",
	},
	// @id lets other page types (notably BlogPosting.author) reference this
	// node instead of re-declaring an anonymous Person, which would fork the
	// entity graph on exactly the pages LLMs are most likely to quote.
	founder: {
		"@type": "Person",
		"@id": `${siteUrl}/#founder`,
		name: "Mithun K. Singh",
		jobTitle: "Founder & CEO",
		sameAs: ["https://www.linkedin.com/in/mithunksingh"],
	},
	contactPoint: {
		"@type": "ContactPoint",
		telephone: PHONE,
		email: SALES_EMAIL,
		contactType: "sales",
		areaServed: "IN",
		availableLanguage: ["en", "hi", "bn"],
	},
	areaServed: "IN",
};
const siteLd = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"@id": `${siteUrl}/#website`,
	name: "Lucoze",
	url: siteUrl,
	publisher: { "@id": `${siteUrl}/#organization` },
	inLanguage: "en-IN",
};
---

<!doctype html>
<html lang="en-IN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogSrc} />
		<meta property="og:locale" content="en_IN" />
		<meta property="og:site_name" content="Lucoze" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogSrc} />

		<meta name="theme-color" content="#c15f3c" />
		{
			/* Single rel=icon (ICO) so browsers can't prefer a stale SVG variant
		    that an intermediate cache layer was holding. apple-touch-icon for
		    iOS Home Screen, mask-icon for Safari pinned tabs. ?v=N is the
		    cache-bust knob — bump it whenever the design changes. */
		}
		<link rel="icon" href="/icon-vault.ico" sizes="any" />
		<link rel="apple-touch-icon" sizes="180x180" href="/touch-icon-vault.png" />
		<link rel="mask-icon" href="/favicon-vault.svg" color="#c15f3c" />

		{
			/* Fonts are self-hosted (src/styles/fonts.css, imported above). The old
		    fonts.googleapis.com stylesheet was render-blocking and cost ~1s on
		    throttled mobile purely from the googleapis→gstatic round trip — it was
		    the dominant LCP bottleneck (SEO audit 2026-07-20: 2,526ms of element
		    render delay on the homepage while the LCP image itself took ~282ms).
		    Preload only the two faces used above the fold: the h1 (Manrope 800)
		    and body text (Inter Tight 400). Everything else loads on demand. */
		}
		<link
			rel="preload"
			href="/fonts/manrope-800-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/inter-tight-400-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
		<script type="application/ld+json" set:html={JSON.stringify(siteLd)} />

		{
			GA_ID && (
				<>
					<script define:vars={{ GA_ID }}>
						{`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
window.gtag = gtag;
gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied'});
try{if(localStorage.getItem('lucoze-consent')==='granted')gtag('consent','update',{ad_storage:'granted',ad_user_data:'granted',ad_personalization:'granted',analytics_storage:'granted'});}catch(e){}
gtag('js', new Date());
gtag('config', GA_ID);`}
					</script>
					<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
				</>
			)
		}

		<slot name="head" />
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to main content</a>

		<Nav activeLink={activeLink} />

		<main id="main">
			<slot />
		</main>

		<Footer />

		<WhatsAppFab />

		{GA_ID && <CookieConsent />}

		{
			import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN && (
				<>
					<script
						defer
						data-domain={import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN}
						src="https://analytics.lucoze.com/js/script.js"
					/>
					{/* Required queue stub. The script above is `defer`, so any
					    window.plausible(...) fired before it loads would hit an
					    undefined global and be silently dropped by track()'s
					    optional chaining. This queues those calls instead. */}
					<script is:inline>
						{`window.plausible=window.plausible||function(){(window.plausible.q=window.plausible.q||[]).push(arguments)}`}
					</script>
				</>
			)
		}

		<script is:inline defer src="/js/tracker.js"></script>

		<script>
			// Global click tracking. Two parallel streams:
			//   - track() → Plausible custom events (Outbound, Mailto)
			//   - LucozeTracker.trackCTAClick → admin.lucoze.com visitor pipeline
			//     (loaded as a classic deferred script above; runs before this
			//     module script, so the global is available by the time the
			//     listener fires).
			import { track } from "../lib/analytics";

			type LucozeTrackerGlobal = {
				trackCTAClick?: (plan: string, region: string) => void;
			};

			const regionFromPath = (path: string): string => {
				const m = path.match(/^\/(ae|sg|au|in)\//);
				return m ? m[1] : "default";
			};

			document.addEventListener("click", (e) => {
				const a = (e.target as HTMLElement | null)?.closest?.("a");
				if (!a) return;
				const href = a.getAttribute("href") || "";

				if (href.startsWith("mailto:")) {
					track("Contact Email Click", { address: href.slice("mailto:".length) });
					return;
				}

				// Demo CTA click — the primary CTA. `placement` (derived from the
				// enclosing section, no per-link markup) + `from` (page) show which
				// buttons/pages drive demo intent.
				if (href.includes("/in/demo/")) {
					const placement = a.closest(".nav")
						? "nav"
						: a.closest(".hero")
							? "hero"
							: a.closest(".cta-final")
								? "bottom-cta"
								: a.closest(".subhero")
									? "page-hero"
									: "inline";
					track("Demo CTA Click", { placement, from: window.location.pathname });
				}

				// Signup CTA click → fire LucozeTracker.trackCTAClick so the
				// admin pipeline flips the visitor's `clicked_free_trial` flag.
				if (href.includes("/signup")) {
					const tracker = (window as unknown as { LucozeTracker?: LucozeTrackerGlobal })
						.LucozeTracker;
					const plan = a.getAttribute("data-plan") || "";
					tracker?.trackCTAClick?.(plan, regionFromPath(window.location.pathname));
				}

				try {
					const url = new URL(href, window.location.href);
					if (url.host && url.host !== window.location.host) {
						track("Outbound Click", { url: url.toString() });
					}
				} catch {
					/* not a parseable URL — ignore */
				}
			});
		</script>
	</body>
</html>
