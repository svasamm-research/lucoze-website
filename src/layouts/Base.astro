---
/**
 * Base.astro — site-wide layout for the Vault redesign (2026).
 * Wraps every page with chrome (Nav + Footer), <head> meta, fonts,
 * favicon, OG/Twitter cards, and optional Plausible analytics.
 */
import "../styles/tokens.css";
import "../styles/sections.css";
import "../styles/subpages.css";
import Nav from "../components/redesign/Nav.astro";
import Footer from "../components/redesign/Footer.astro";

interface Props {
	title: string;
	description: string;
	canonical?: string;
	activeLink?: string;
	ogImage?: string;
}

const {
	title,
	description,
	canonical = Astro.url.href,
	ogImage = "/og-default.png",
	activeLink = "",
} = Astro.props;

const siteUrl = "https://lucoze.com";
const fullTitle = title.toLowerCase().includes("lucoze") ? title : `${title} | Lucoze`;

// Site-wide entity graph. Emitted on every page so Google/LLMs can resolve
// "Lucoze" (brand) → Svasamm Research Pvt. Ltd. (legal entity) with a founder
// node for corroboration. The homepage adds a page-specific FAQPage on top.
const orgLd = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"@id": `${siteUrl}/#organization`,
	name: "Lucoze",
	legalName: "Svasamm Research Pvt. Ltd.",
	url: siteUrl,
	logo: `${siteUrl}/favicon-vault-32.png`,
	sameAs: [
		"https://www.linkedin.com/company/113023331/",
		"https://www.crunchbase.com/organization/lucoze",
		"https://x.com/lucozehq",
	],
	telephone: "+91 9147144638",
	address: {
		"@type": "PostalAddress",
		addressLocality: "Konnagar",
		addressRegion: "West Bengal",
		postalCode: "712246",
		addressCountry: "IN",
	},
	founder: {
		"@type": "Person",
		name: "Mithun K. Singh",
		jobTitle: "Founder & CEO",
		sameAs: ["https://www.linkedin.com/in/mithunksingh"],
	},
	contactPoint: {
		"@type": "ContactPoint",
		telephone: "+91 9147144638",
		email: "hello@lucoze.com",
		contactType: "sales",
		areaServed: "IN",
		availableLanguage: ["en", "hi", "bn"],
	},
	areaServed: "IN",
};
const siteLd = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"@id": `${siteUrl}/#website`,
	name: "Lucoze",
	url: siteUrl,
	publisher: { "@id": `${siteUrl}/#organization` },
	inLanguage: "en-IN",
};
---

<!doctype html>
<html lang="en-IN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta
			property="og:image"
			content={ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`}
		/>
		<meta property="og:locale" content="en_IN" />
		<meta property="og:site_name" content="Lucoze" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta
			name="twitter:image"
			content={ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`}
		/>

		<meta name="theme-color" content="#c15f3c" />
		{
			/* Single rel=icon (ICO) so browsers can't prefer a stale SVG variant
		    that an intermediate cache layer was holding. apple-touch-icon for
		    iOS Home Screen, mask-icon for Safari pinned tabs. ?v=N is the
		    cache-bust knob — bump it whenever the design changes. */
		}
		<link rel="icon" href="/icon-vault.ico" sizes="any" />
		<link rel="apple-touch-icon" sizes="180x180" href="/touch-icon-vault.png" />
		<link rel="mask-icon" href="/favicon-vault.svg" color="#c15f3c" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Fraunces:ital,opsz,wght@0,9..144,400..600;1,9..144,400..600&display=swap"
		/>

		<script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
			<script type="application/ld+json" set:html={JSON.stringify(siteLd)} />

			<slot name="head" />
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to main content</a>

		<Nav activeLink={activeLink} />

		<main id="main">
			<slot />
		</main>

		<Footer />

		{
			import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN && (
				<script
					defer
					data-domain={import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN}
					src="https://analytics.lucoze.com/js/script.js"
				/>
			)
		}

		<script is:inline defer src="/js/tracker.js"></script>

		<script>
			// Global click tracking. Two parallel streams:
			//   - track() → Plausible custom events (Outbound, Mailto)
			//   - LucozeTracker.trackCTAClick → admin.lucoze.com visitor pipeline
			//     (loaded as a classic deferred script above; runs before this
			//     module script, so the global is available by the time the
			//     listener fires).
			import { track } from "../lib/analytics";

			type LucozeTrackerGlobal = {
				trackCTAClick?: (plan: string, region: string) => void;
			};

			const regionFromPath = (path: string): string => {
				const m = path.match(/^\/(ae|sg|au|in)\//);
				return m ? m[1] : "default";
			};

			document.addEventListener("click", (e) => {
				const a = (e.target as HTMLElement | null)?.closest?.("a");
				if (!a) return;
				const href = a.getAttribute("href") || "";

				if (href.startsWith("mailto:")) {
					track("Contact Email Click", { address: href.slice("mailto:".length) });
					return;
				}

				// Signup CTA click → fire LucozeTracker.trackCTAClick so the
				// admin pipeline flips the visitor's `clicked_free_trial` flag.
				if (href.includes("/signup")) {
					const tracker = (window as unknown as { LucozeTracker?: LucozeTrackerGlobal })
						.LucozeTracker;
					const plan = a.getAttribute("data-plan") || "";
					tracker?.trackCTAClick?.(plan, regionFromPath(window.location.pathname));
				}

				try {
					const url = new URL(href, window.location.href);
					if (url.host && url.host !== window.location.host) {
						track("Outbound Click", { url: url.toString() });
					}
				} catch {
					/* not a parseable URL — ignore */
				}
			});
		</script>
	</body>
</html>
