---
import { getCollection, render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import Crumbs from "../../../components/Crumbs.astro";
import Icon from "../../../components/Icon.astro";
import SubscribeForm from "../../../components/SubscribeForm.astro";
import { isPublished } from "../../../lib/posts";
import { newsletterEnabled } from "../../../lib/env";

export async function getStaticPaths() {
	const posts = await getCollection("blog", ({ data }) => isPublished(data));
	return posts.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const post = entry.data;

// Posts author section headings as HTML `<h2 id="…">` (not Markdown `##`), so
// Astro's `headings` export is empty. Build the "In this post" TOC from the raw
// MDX body instead — every H2 carries a stable id we anchor to.
const toc = [...(entry.body ?? "").matchAll(/<h2[^>]*\sid="([^"]+)"[^>]*>([\s\S]*?)<\/h2>/g)].map(
	(m) => ({ slug: m[1], text: m[2].replace(/<[^>]+>/g, "").trim() }),
);

// Topic-cluster cross-linking: other posts in the same cluster, pillar first.
const CLUSTER_LABELS: Record<string, string> = {
	abdm: "ABDM & ABHA",
	dpdp: "DPDP compliance",
	billing: "billing & GST",
	switching: "switching clinic software",
};
const clusterPosts = post.cluster
	? (await getCollection("blog"))
			.filter((p) => p.data.cluster === post.cluster && p.id !== entry.id && isPublished(p.data))
			.sort((a, b) => Number(b.data.pillar) - Number(a.data.pillar))
	: [];
const clusterLabel = post.cluster ? (CLUSTER_LABELS[post.cluster] ?? post.cluster) : "";

// ABDM posts pull the site's warmest traffic (hospitals researching compliance),
// so they carry a targeted "free ABDM readiness check" lead offer.
const isAbdm = post.cluster === "abdm";

const fmtDateOpts = { day: "numeric", month: "short", year: "numeric" } as const;
const fmtDate = post.date.toLocaleDateString("en-IN", fmtDateOpts);
// Show an "Updated" line only when a post was materially revised after publish.
const fmtUpdated =
	post.updated && post.updated.getTime() !== post.date.getTime()
		? post.updated.toLocaleDateString("en-IN", fmtDateOpts)
		: null;

const siteUrl = (Astro.site?.toString() ?? "https://lucoze.com/").replace(/\/$/, "");
const postUrl = `${siteUrl}${Astro.url.pathname}`;
const blogPostingLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: post.title,
	description: post.dek,
	datePublished: post.date.toISOString(),
	dateModified: (post.updated ?? post.date).toISOString(),
	// Reference the sitewide Organization/Person nodes from Base.astro by @id
	// rather than re-declaring them here — re-declaring emitted a second,
	// unlinked Organization + Person on every post and forked the entity graph.
	// Every post is currently founder-authored; add a name→@id map here if that
	// ever stops being true.
	author: { "@id": `${siteUrl}/#founder` },
	publisher: { "@id": `${siteUrl}/#organization` },
	mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
	image: `${siteUrl}/og-default.png`,
	articleSection: post.category,
};
---

<Base title={post.title} description={post.dek}>
	<script type="application/ld+json" set:html={JSON.stringify(blogPostingLd)} />

	<article data-blog-slug={entry.id} hidden></article>

	<script>
		// Blog read-depth events. Fires once per session at 50% scroll and
		// once when the bottom of the article enters the viewport.
		// Slug is read from a hidden DOM marker rather than via define:vars,
		// because define:vars forces inline non-module emit which breaks
		// ES `import` statements.
		import { track } from "../../../lib/analytics";
		const marker = document.querySelector<HTMLElement>("[data-blog-slug]");
		const slug = marker?.getAttribute("data-blog-slug") || "unknown";
		const article = document.querySelector<HTMLElement>(".post");
		if (article) {
			let fired50 = false;
			let firedDone = false;
			const onScroll = () => {
				const rect = article.getBoundingClientRect();
				const articleHeight = rect.height;
				const scrolled = Math.max(0, -rect.top);
				const pct = articleHeight > 0 ? scrolled / articleHeight : 0;
				if (!fired50 && pct >= 0.5) {
					fired50 = true;
					track("Blog Read 50%", { slug });
				}
				if (!firedDone && rect.bottom <= window.innerHeight + 100) {
					firedDone = true;
					track("Blog Read Complete", { slug });
					window.removeEventListener("scroll", onScroll);
				}
			};
			window.addEventListener("scroll", onScroll, { passive: true });
		}
	</script>
	<section class="section section--tight" style="padding-top: var(--s-12);">
		<div class="container">
			<Crumbs
				items={[
					{ href: "/in/", label: "Home" },
					{ href: "/in/blog/", label: "Blog" },
					{ label: post.category },
				]}
			/>
			<div class="post-layout">
				<aside class="post-toc">
					<div class="post-toc__head">In this post</div>
					<div class="post-toc__list">
						{toc.map((t) => <a href={`#${t.slug}`}>{t.text}</a>)}
					</div>
					{
						newsletterEnabled && (
							<div class="post-sidebar-sub">
								<span class="post-sidebar-sub__label">Newsletter</span>
								<SubscribeForm variant="sidebar" placement="blog-post-sidebar" />
							</div>
						)
					}
					<div
						style="margin-top: var(--s-6); padding: var(--s-4); background: var(--paper); border: 1px solid var(--border); border-radius: var(--r-md); font-size: 12px; line-height: 1.5; color: var(--muted);"
					>
						<div
							style="font-family: var(--font-mono); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink); margin-bottom: 6px;"
						>
							{isAbdm ? "Free ABDM check" : "Try Lucoze"}
						</div>
						{
							isAbdm ? (
								<>
									See where your facility stands on HFR, HPR & ABHA.
									<br />
									<a href="/in/abdm-readiness/" style="color: var(--primary); font-weight: 600;">
										Get my free check →
									</a>
								</>
							) : (
								<>
									14-day free trial. No credit card.
									<br />
									<a href="/in/demo/" style="color: var(--primary); font-weight: 600;">
										Book a demo →
									</a>
								</>
							)
						}
					</div>
				</aside>
				<article class="post">
					<span class="t-eyebrow">{post.category}</span>
					<h1 style="margin-top: var(--s-3);">{post.title}</h1>
					<div class="post__meta">
						{
							/* Byline links to the author bio — an E-E-A-T signal that
						    matters on compliance/YMYL-adjacent posts. */
						}
						<span><a href="/in/about/" rel="author">{post.author}</a></span>
						<span>{fmtDate}</span>
						{fmtUpdated && <span>Updated {fmtUpdated}</span>}
						<span>{post.readMins} min read</span>
					</div>
					<p class="post__lead">{post.dek}</p>
					{
						post.heroImage && (
							<img
								class="post__hero"
								src={post.heroImage}
								alt={post.heroAlt ?? post.title}
								width="1200"
								height="600"
								loading="eager"
								decoding="async"
							/>
						)
					}
					<Content />
				</article>
			</div>
		</div>
	</section>

	{
		isAbdm && (
			<section class="section section--tight">
				<div class="container">
					<div class="cta-final" style="padding: var(--s-10) var(--s-8);">
						<span class="t-eyebrow" style="color: var(--accent);">
							Free ABDM readiness check
						</span>
						<h2 style="font-size: clamp(22px, 3vw, 32px); margin: var(--s-2) 0 var(--s-3);">
							Not sure if your facility is ABDM-ready?
						</h2>
						<p>
							Get a plain, prioritised read on where you stand — HFR, HPR and ABHA — and exactly
							what's left to do. No cost, no obligation.
						</p>
						<div class="cta-final__actions">
							<a href="/in/abdm-readiness/" class="btn btn--accent btn--lg">
								Get my free ABDM check
								<Icon name="arrow" size={16} class="btn__arrow" />
							</a>
						</div>
					</div>
				</div>
			</section>
		)
	}

	{
		clusterPosts.length > 0 && (
			<section class="section section--tight">
				<div class="container">
					<header class="section-header section-header--left">
						<span class="t-eyebrow">More in this series</span>
						<h2 class="t-h2" style="margin-top: 8px;">
							Keep reading on {clusterLabel}.
						</h2>
					</header>
					<div class="module-grid module-grid--series">
						{clusterPosts.map((p) => (
							<a class="module-card" href={`/in/blog/${p.id}/`}>
								<div class="module-card__title">
									{p.data.title}
									{p.data.pillar && " ·  the guide"}
								</div>
								<div class="module-card__blurb">{p.data.dek}</div>
								<span class="module-card__arrow">
									Read <Icon name="arrow" size={13} />
								</span>
							</a>
						))}
					</div>
				</div>
			</section>
		)
	}

	<section class="section">
		<div class="container">
			<div class="cta-final" style="padding: var(--s-12) var(--s-8);">
				<h2 style="font-size: clamp(24px, 3vw, 36px); margin-bottom: var(--s-3);">
					Found this useful?
				</h2>
				<p>
					More posts like this drop weekly. Or talk to us — if your clinic is dealing with something
					we should write about, tell us.
				</p>
				<div class="cta-final__actions">
					<a href="/in/blog/" class="btn btn--accent btn--lg">
						Read more posts
						<Icon name="arrow" size={16} class="btn__arrow" />
					</a>
					<a href="/in/contact/" class="btn btn--ghost btn--lg">Get in touch</a>
				</div>
			</div>
		</div>
	</section>
</Base>
