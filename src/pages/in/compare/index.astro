---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import SubHero from "../../../components/SubHero.astro";
import Icon from "../../../components/Icon.astro";
import GuideProse from "../../../components/GuideProse.astro";
import { COMPARE_GUIDE } from "../../../data/solutions-guides.ts";

const comparisons = (await getCollection("compare")).sort((a, b) =>
	a.data.competitor.localeCompare(b.data.competitor),
);

const h1Parts = ["Lucoze, ", "compared", "."];
---

<Base
	title="Clinic and Hospital Software Alternatives Compared"
	description="Lucoze compared with Practo Ray, HealthPlix, MocDoc, KareXpert, Halemind and CliniQ360: one record, pricing, moving in, accounts, GST and leaving, side by side."
>
	<SubHero
		crumbs={[{ href: "/in/", label: "Home" }, { label: "Compare" }]}
		eyebrow="Compare"
		h1={h1Parts.join("")}
		highlightParts={h1Parts}
		lead="Side-by-side, factual comparisons against other hospital and clinic management software — so you can see exactly where the platforms differ, and switch without a day of downtime."
		primaryCta={{ href: "/in/demo/", label: "Book a demo" }}
		secondaryCta={{ href: "/in/pricing/", label: "See pricing" }}
	/>

	<section class="section section--tight">
		<div class="container">
			<div class="module-grid">
				{
					comparisons.map((c) => (
						<a class="module-card" href={`/in/compare/${c.data.slug}/`}>
							<div class="module-card__icon">
								<Icon name="chart" size={20} />
							</div>
							<div class="module-card__title">Lucoze vs {c.data.competitor}</div>
							<div class="module-card__blurb">{c.data.eyebrow}</div>
							<span class="module-card__arrow">
								Compare <Icon name="arrow" size={13} />
							</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<GuideProse eyebrow="How to compare" sections={COMPARE_GUIDE} />
</Base>
