---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import "../../styles/contact-partner.css";

const REACH = {
	email: "hello@lucoze.com",
	wa: "918217820249",
	waPretty: "+91 82178 20249",
};

const CONTACT_STEPS: [string, string][] = [
	["Leave your line", "Two fields — your name and clinic number. Ten seconds, no forms to fill."],
	["We call you back", "Mithun rings your clinic line within a day. No queue, no call centre."],
	[
		"A real conversation",
		"What's slow in your clinic today, what you need. No script, no pressure.",
	],
	[
		"Go live in 14 days",
		"If it's a fit, we migrate your data and train your staff — you keep working.",
	],
];

const EXPECT: [string, string, string][] = [
	[
		"clock",
		"A call back within a day",
		"Mithun rings your clinic line himself — no call centre, no queue.",
	],
	[
		"users",
		"You talk to the founder",
		"The person who builds Lucoze, not a sales rep working a script.",
	],
	["lock", "Your number is safe", "We call you once. We never sell it to agencies. Full stop."],
];

const TRUST: [string, string, string][] = [
	["clock", "Team replies in a day", "Founder line — not a call centre"],
	["shield", "Patient data hosted in Mumbai", "ABDM-ready · DPDP-aligned"],
	["lock", "No spam, no sales sequence", "One human, one honest reply"],
];
---

<Base
	title="Contact Lucoze — Indian healthcare management software"
	description="Leave your clinic line. Mithun, the founder, calls you back within a day. No call centre, no sales sequence — one honest reply."
>
	{/* Hero — heading left, form right */}
	<section class="reach-hero">
		<div class="container">
			<div class="reach-hero__grid">
				<div>
					<div class="reach-hero__eyebrow"><span class="reach-dot"></span> Request a call back</div>
					<h1 class="reach-hero__h1">
						Leave your clinic line.<br />Mithun calls you back — within a day.
					</h1>
					<p class="reach-hero__lead">
						Two fields, ten seconds. Leave your clinic line and the team calls you back — within
						a day. It reaches Mithun, who runs Lucoze.
					</p>
				</div>

				<aside class="reach-card reach-card--hero" data-contact-card>
					<form class="contact-form" data-contact-form novalidate>
						<div class="reach-card__head">
							<span class="reach-step"><Icon name="play" size={14} /></span>
							<h2>We'll call you back</h2>
						</div>

						<div class="reach-fields reach-fields--mini">
							<div class="reach-field reach-field--full">
								<label for="c-name">Name <em>*</em></label>
								<div class="reach-name" data-name-wrap>
									<select
										class="reach-name__title"
										name="title"
										aria-label="Title"
									>
										<option value="Dr." selected>Dr.</option>
										<option value="Mr.">Mr.</option>
										<option value="Mrs.">Mrs.</option>
										<option value="Ms.">Ms.</option>
									</select>
									<input id="c-name" name="name" placeholder="Soumya Sen" required />
								</div>
							</div>

							<div class="reach-field reach-field--full">
								<label for="c-phone">Desk phone number</label>
								<div class="reach-phone" data-phone-wrap>
									<span class="reach-phone__cc">+91</span>
									<input
										id="c-phone"
										name="phone"
										inputmode="numeric"
										maxlength="10"
										placeholder="10-digit desk line"
									/>
								</div>
								<span class="reach-err" data-phone-err hidden>
									Enter a valid 10-digit Indian number.
								</span>
							</div>

							<div class="reach-or reach-field--full"><span>or</span></div>

							<div class="reach-field reach-field--full">
								<label for="c-email">Official email</label>
								<input
									id="c-email"
									name="email"
									inputmode="email"
									placeholder="clinic@hospital.in"
								/>
								<span class="reach-err" data-email-err hidden>
									Enter a valid email address.
								</span>
							</div>

							<button
								type="submit"
								class="btn btn--accent btn--lg reach-field--full"
								data-contact-submit
								style="justify-content: center; opacity: 0.5;"
								disabled
							>
								<Icon name="inbox" size={17} />
								<span data-contact-submit-label>Request a call back</span>
							</button>

							<p class="reach-promise reach-field--full">
								<Icon name="lock" size={15} /> Whatever you share stays with us — we reach out
								once, and never sell it to agencies.
							</p>

							<p
								class="reach-err reach-field--full"
								data-contact-error
								hidden
								role="alert"
								style="text-align: center;"
							>
							</p>
						</div>
					</form>
				</aside>

				<aside class="reach-card reach-card--hero" data-contact-success hidden>
					<div class="reach-success reach-success--inline">
						<span class="reach-success__badge"><Icon name="check" size={26} /></span>
						<h3>Got it — we'll call you back.</h3>
						<p>
							Mithun got the ping. The team replies within a day. <strong
								>Your number stays with us — we call you once, and never sell it to
								agencies.</strong
							>
						</p>
						<div class="reach-success__row">
							<a
								class="btn btn--ghost"
								href={`https://wa.me/${REACH.wa}`}
								target="_blank"
								rel="noopener"
							>
								Prefer WhatsApp? Message us
							</a>
							<a class="btn btn--primary" href="/in/">
								Back to home <Icon name="arrow" size={15} class="btn__arrow" />
							</a>
						</div>
						<button type="button" class="reach-success__again" data-contact-reset
							>Send another →</button
						>
					</div>
				</aside>
			</div>
		</div>
	</section>

	{/* How it works */}
	<section class="section section--tight">
		<div class="container">
			<h2 class="dp-h2">How it works</h2>
			<div class="dp-steps">
				{
					CONTACT_STEPS.map(([t, s], i) => (
						<div class="dp-step">
							<span class="dp-step__n">{i + 1}</span>
							<div class="dp-step__t">{t}</div>
							<div class="dp-step__s">{s}</div>
						</div>
					))
				}
			</div>
		</div>
	</section>

	{/* When you reach out + trust row */}
	<section class="section section--tight">
		<div class="container" style="max-width: 1000px;">
			<div class="reach-bottom">
				<aside class="reach-expect">
					<div class="reach-expect__head">When you reach out</div>
					{
						EXPECT.map(([ic, t, s]) => (
							<div class="reach-expect__row">
								<span class="reach-expect__ic">
									<Icon name={ic} size={19} />
								</span>
								<div>
									<div class="reach-expect__t">{t}</div>
									<div class="reach-expect__s">{s}</div>
								</div>
							</div>
						))
					}
					<div class="reach-expect__foot">
						<span class="reach-expect__sig">— Mithun</span>, Founder &amp; CEO
					</div>
				</aside>

				<div class="reach-trust">
					{
						TRUST.map(([ic, t, s]) => (
							<div class="reach-trust__item">
								<span class="reach-trust__ic">
									<Icon name={ic} size={18} />
								</span>
								<div>
									<div class="reach-trust__t">{t}</div>
									<div class="reach-trust__s">{s}</div>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</section>
</Base>

<script>
	import { initLeadForm } from "../../lib/lead-form";
	initLeadForm({ source: "contact", successHref: "/in/" });
</script>
