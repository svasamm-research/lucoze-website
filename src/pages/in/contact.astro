---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import LeadForm from "../../components/LeadForm.astro";
import "../../styles/contact-partner.css";

const CONTACT_STEPS: [string, string][] = [
	["Leave your line", "Two fields — your name and clinic number. Ten seconds, no forms to fill."],
	["We call you back", "We ring your clinic line within a day. No queue, no call centre."],
	[
		"A real conversation",
		"What's slow in your clinic today, what you need. No script, no pressure.",
	],
	[
		"Go live in 14 days",
		"If it's a fit, we migrate your data and train your staff — you keep working.",
	],
];

const EXPECT: [string, string, string][] = [
	[
		"clock",
		"A call back within a day",
		"We ring your clinic line — no call centre, no queue.",
	],
	[
		"users",
		"You talk to the team",
		"The people who build Lucoze, not a sales rep working a script.",
	],
	["lock", "Your number is safe", "We call you once. We never sell it to agencies. Full stop."],
];

const TRUST: [string, string, string][] = [
	["clock", "Team replies in a day", "Direct line — not a call centre"],
	["shield", "Patient data hosted in Mumbai", "ABDM-ready · DPDP-aligned"],
	["lock", "No spam, no sales sequence", "One human, one honest reply"],
];
---

<Base
	title="Contact Lucoze — Indian healthcare management software"
	description="Leave your clinic line. We call you back within a day. No call centre, no sales sequence — one honest reply."
>
	{/* Hero — heading left, form right */}
	<section class="reach-hero">
		<div class="container">
			<div class="reach-hero__grid">
				<div>
					<div class="reach-hero__eyebrow"><span class="reach-dot"></span> Request a call back</div>
					<h1 class="reach-hero__h1">
						Leave your clinic line.<br />We call you back — within a day.
					</h1>
					<p class="reach-hero__lead">
						Two fields, ten seconds. Leave your clinic line and the team calls you back — within a
						day. It reaches the team that builds Lucoze.
					</p>
				</div>

				<LeadForm
					heading="We'll call you back"
					submitLabel="Request a call back"
					successHeading="Got it — we'll call you back."
					successBody="We got the ping. The team replies within a day. Your number stays with us — we call you once, and never sell it to agencies."
				/>
			</div>
		</div>
	</section>

	{/* How it works */}
	<section class="section section--tight">
		<div class="container">
			<h2 class="dp-h2">How it works</h2>
			<div class="dp-steps">
				{
					CONTACT_STEPS.map(([t, s], i) => (
						<div class="dp-step">
							<span class="dp-step__n">{i + 1}</span>
							<div class="dp-step__t">{t}</div>
							<div class="dp-step__s">{s}</div>
						</div>
					))
				}
			</div>
		</div>
	</section>

	{/* When you reach out + trust row */}
	<section class="section section--tight">
		<div class="container" style="max-width: 1000px;">
			<div class="reach-bottom">
				<aside class="reach-expect">
					<div class="reach-expect__head">When you reach out</div>
					{
						EXPECT.map(([ic, t, s]) => (
							<div class="reach-expect__row">
								<span class="reach-expect__ic">
									<Icon name={ic} size={19} />
								</span>
								<div>
									<div class="reach-expect__t">{t}</div>
									<div class="reach-expect__s">{s}</div>
								</div>
							</div>
						))
					}
					<div class="reach-expect__foot">
						<span class="reach-expect__sig">— The Lucoze team</span>
					</div>
				</aside>

				<div class="reach-trust">
					{
						TRUST.map(([ic, t, s]) => (
							<div class="reach-trust__item">
								<span class="reach-trust__ic">
									<Icon name={ic} size={18} />
								</span>
								<div>
									<div class="reach-trust__t">{t}</div>
									<div class="reach-trust__s">{s}</div>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</section>
</Base>

<script>
	import { initLeadForm } from "../../lib/lead-form";
	initLeadForm({ source: "contact", successHref: "/in/" });
</script>
