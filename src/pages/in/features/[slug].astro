---
import { getCollection, getEntry } from "astro:content";
import Base from "../../../layouts/Base.astro";
import SubHero from "../../../components/SubHero.astro";
import FRow from "../../../components/FRow.astro";
import FeatureVisual from "../../../components/visuals/FeatureVisual.astro";
import ProductGalleries from "../../../components/ProductGalleries.astro";
import Icon from "../../../components/Icon.astro";
import Faq from "../../../components/Faq.astro";

export async function getStaticPaths() {
	const features = await getCollection("features");
	return features.map((entry) => ({
		params: { slug: entry.data.slug },
	}));
}

const { slug } = Astro.params;
const entry = await getEntry("features", slug!);
if (!entry) {
	return Astro.redirect("/404");
}
const feature = entry.data;

// Which flow gallery (if any) belongs on this feature page. Galleries live in
// context here rather than crowding the homepage.
const FEATURE_GALLERY: Record<string, string> = {
	appointments: "front-office",
	"patient-records": "clinical",
	lab: "lab",
	pharmacy: "pharmacy",
	billing: "billing",
};
const galleryId = FEATURE_GALLERY[slug!];

// BreadcrumbList is already emitted by SubHero → Crumbs; only add the FAQPage.
const faqLd = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: feature.faqs.map((f) => ({
		"@type": "Question",
		name: f.q,
		acceptedAnswer: { "@type": "Answer", text: f.a },
	})),
};
---

<Base title={`${feature.label} — Lucoze`} description={feature.lead.slice(0, 160)}>
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(faqLd)} />
	<SubHero
		crumbs={[
			{ href: "/in/", label: "Home" },
			{ href: "/in/features/", label: "Product" },
			{ label: feature.label },
		]}
		eyebrow={feature.eyebrow}
		h1={feature.h1Parts.join("")}
		highlightParts={feature.h1Parts}
		lead={feature.lead}
		primaryCta={{ href: "/in/demo/", label: "Book a demo" }}
		secondaryCta={{ href: "/in/contact/", label: "Talk to us" }}
		statsRow={feature.stats}
	>
		{galleryId && <ProductGalleries flows={[galleryId]} hero slot="visual" />}
	</SubHero>

	<section class="section section--tight">
		<div class="container">
			{
				feature.rows.map((row, i) => (
					<FRow
						eyebrow={row.eyebrow}
						title={row.title}
						lead={row.lead}
						bullets={row.bullets}
						flip={i % 2 === 1}
					>
						<FeatureVisual slot="visual" kind={row.visual} />
					</FRow>
				))
			}
		</div>
	</section>

	<section class="section section--tight">
		<div class="container">
			<header class="section-header">
				<span class="t-eyebrow">Common questions</span>
				<h2 class="t-h2" style="margin-top: 8px;">
					{feature.label}, the doubts our customers raised first.
				</h2>
			</header>
			<Faq items={feature.faqs} />
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="cta-final" style="padding: var(--s-12) var(--s-8);">
				<h2 style="font-size: clamp(24px, 3vw, 36px); margin-bottom: var(--s-3);">
					See {feature.label} working in your clinic.
				</h2>
				<p>14-day free trial. No credit card. Migration help included.</p>
				<div class="cta-final__actions">
					<a href="/in/demo/" class="btn btn--primary btn--lg">
						Book a demo
						<Icon name="arrow" size={16} class="btn__arrow" />
					</a>
					<a href="/in/pricing/" class="btn btn--ghost btn--lg">Compare plans</a>
				</div>
			</div>
		</div>
	</section>
</Base>
