---
import Base from "../../layouts/Base.astro";
import HeroDemo from "../../components/HeroDemo.astro";
import TrustStrip from "../../components/TrustStrip.astro";
import Icon from "../../components/Icon.astro";
import Faq from "../../components/Faq.astro";
import CompareTable from "../../components/CompareTable.astro";
import SpecialtyVisual from "../../components/visuals/SpecialtyVisual.astro";
import RoiCalculator from "../../components/islands/RoiCalculator.tsx";
import { DIFF_ROWS, HOME_FAQS } from "../../data/home-content.ts";
import { SPECIALTY_PILLS } from "../../data/specialties.ts";

// Which specialty is selected when the page loads.
const DEFAULT_SPECIALTY = "diag";
const defaultCaption =
	SPECIALTY_PILLS.find((s) => s.id === DEFAULT_SPECIALTY)?.caption ?? SPECIALTY_PILLS[0].caption;
---

<Base
	title="Hospital & Clinic Management Software for India"
	description="Lucoze runs OPD, IPD, OT, lab, pharmacy and billing on one platform for Indian hospitals and clinics. ABDM-ready, data hosted in India, and you switch off your old system without a day of downtime."
	activeLink="home"
>
	<HeroDemo />

	<TrustStrip />

	<!-- Pick your specialty — vanilla-JS switcher swaps the visible
	     SpecialtyVisual block + caption on pill click. All 6 visuals are
	     rendered at build time; toggle is hidden-attr. -->
	<section class="section" id="product" aria-labelledby="product-heading">
		<div class="container">
			<header class="section-header">
				<h2 id="product-heading" class="t-h1">Pick your specialty. See it working.</h2>
				<p class="t-lead">
					Lucoze isn't a generic platform with specialty add-ons. Every workflow below is built
					around how that kind of hospital or clinic actually operates — front desk, wards, and back
					office.
				</p>
			</header>

			<div class="specialty" role="tablist" aria-label="Specialty selector">
				{
					SPECIALTY_PILLS.map((s) => (
						<button
							type="button"
							role="tab"
							aria-selected={s.id === DEFAULT_SPECIALTY}
							aria-controls={`specialty-panel-${s.id}`}
							id={`specialty-tab-${s.id}`}
							data-specialty-pill={s.id}
							data-specialty-caption-for={s.caption}
							class:list={[
								"specialty__btn",
								s.id === DEFAULT_SPECIALTY && "specialty__btn--active",
							]}
						>
							<Icon name={s.icon} class="specialty__btn-icon" />
							{s.label}
						</button>
					))
				}
			</div>

			<p class="product-caption" data-specialty-caption>{defaultCaption}</p>

			<div class="product-preview-placeholder">
				{
					SPECIALTY_PILLS.map((s) => (
						<div
							data-specialty-visual={s.id}
							role="tabpanel"
							id={`specialty-panel-${s.id}`}
							aria-labelledby={`specialty-tab-${s.id}`}
							hidden={s.id !== DEFAULT_SPECIALTY}
						>
							<SpecialtyVisual kind={s.visualKind} />
						</div>
					))
				}
			</div>
		</div>

		<!-- Differentiation matrix — fully static -->
		<section class="section section--tight" id="compliance" aria-labelledby="diff-heading">
			<div class="container">
				<header class="section-header">
					<span class="t-eyebrow">How Lucoze is different</span>
					<h2 id="diff-heading" class="t-h1" style="margin-top: 8px; margin-bottom: 12px;">
						Compared to what you're using today.
					</h2>
					<p class="t-lead">
						We didn't build the same product as everyone else. The differences are intentional and
						they're built around how Indian healthcare actually buys, switches, and runs.
					</p>
				</header>

				<CompareTable
					columns={["Capability", "Lucoze", "Practo Ray", "Legacy HIS", "Excel + paper"]}
					rows={DIFF_ROWS}
				/>

				<p
					class="t-small"
					style="text-align: center; margin-top: var(--s-5); color: var(--light); font-style: italic;"
				>
					Comparison based on public documentation as of May 2026. "Partial" = capability exists but
					requires configuration / paid add-on / external integration.
				</p>
			</div>
		</section>

		<!-- Explore the platform — link-out to per-module galleries on the feature
		     and hospital pages (home stays light; galleries live in context). -->
		<section class="section" id="tour" aria-labelledby="tour-heading">
			<div class="container">
				<header class="section-header">
					<span class="t-eyebrow">A look inside</span>
					<h2 id="tour-heading" class="t-h1" style="margin-top: 8px; margin-bottom: 12px;">
						See the platform, not a promise.
					</h2>
					<p class="t-lead">
						Real screens for every part of the practice. Open the module that matters to you.
					</p>
				</header>
				<nav class="platform-explore" aria-label="Explore the platform by module">
					<a href="/in/features/appointments/">Front office</a>
					<a href="/in/features/patient-records/">Clinical records</a>
					<a href="/in/features/lab/">Laboratory</a>
					<a href="/in/features/pharmacy/">Pharmacy</a>
					<a href="/in/features/billing/">Billing &amp; GST</a>
					<a href="/in/solutions/hospitals/">Hospital — IPD, OT, emergency, TPA</a>
				</nav>
			</div>
		</section>

		<!-- ROI section — RoiCalculator is a React island mounted on visibility. -->
		<section class="section" id="roi" aria-labelledby="roi-heading">
			<div class="container">
				<header class="section-header">
					<span class="t-eyebrow">ROI calculator</span>
					<h2 id="roi-heading" class="t-h1" style="margin-top: 8px; margin-bottom: 12px;">
						See what your clinic actually saves per month.
					</h2>
					<p class="t-lead">
						Slide the inputs to your clinic's shape. Numbers are conservative — derived from
						conversations with East-India clinic owners.
					</p>
				</header>
				<RoiCalculator client:visible />
				<div style="text-align: center; margin-top: var(--s-8);">
					<a href="/in/demo/" class="btn btn--accent btn--lg btn--wrap">
						Apply these savings to my clinic — Book a demo
						<Icon name="arrow" size={16} class="btn__arrow" />
					</a>
				</div>
			</div>
		</section>

		<!-- Founder section — fully static -->
		<section
			class="section"
			id="story"
			aria-labelledby="founder-heading"
			style="background: var(--paper); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);"
		>
			<div class="container">
				<div class="founder founder--cards">
					<div class="founder__col">
						<span class="t-eyebrow">Why Lucoze exists</span>
						<h2 id="founder-heading" class="t-h1" style="margin: 8px 0 var(--s-6);">
							We built Lucoze because someone we love runs a clinic too.
						</h2>

						<blockquote class="founder__quote">
							Where does your patient data live? If the answer is anywhere outside India, we have a
							problem before we have a customer.
						</blockquote>

						<div class="founder__bullets" role="list" aria-label="Founder commitments">
							<div class="founder__bullet">
								<Icon name="check" size={16} />
								<div>
									<strong style="color: var(--ink);">All data sits in India.</strong>
									Not the US, not Singapore. We pay 38% more for hosting to keep it that way.
								</div>
							</div>
							<div class="founder__bullet">
								<Icon name="check" size={16} />
								<div>
									<strong style="color: var(--ink);"
										>Six months free for design-partner clinics.</strong
									>
									First ten East-India clinics get six months on the house and a weekly call with me.
								</div>
							</div>
							<div class="founder__bullet">
								<Icon name="check" size={16} />
								<div>
									<strong style="color: var(--ink);">No lock-in.</strong>
									If you ever leave, your full data exports as CSV + PDF within 24 hours. We'd rather
									lose you than trap you.
								</div>
							</div>
							<div class="founder__bullet">
								<Icon name="check" size={16} />
								<div>
									<strong style="color: var(--ink);">Direct line to me.</strong>
									First-name basis. WhatsApp during business hours. Until we have 100 clinics, this is
									non-negotiable.
								</div>
							</div>
						</div>

						<div class="founder__sig">
							<img
								src="/images/founder-mithun-avatar.jpg"
								alt="Mithun K. Singh, founder of Lucoze"
								width="64"
								height="64"
								loading="lazy"
								class="founder__sig-avatar"
							/>
							<div>
								<div class="founder__sig-name">Mithun K. Singh</div>
								<div class="founder__sig-role">Founder & CEO, Lucoze</div>
							</div>
							<a href="/in/design-partner/" class="btn btn--accent" style="margin-left: auto;">
								Apply
								<Icon name="arrow" size={14} class="btn__arrow" />
							</a>
						</div>
					</div>

					<div class="founder__col">
						<span class="t-eyebrow">Our mission</span>
						<h2 class="t-h1" style="margin: 8px 0 var(--s-6);">
							Build the clinic software we'd want our own family to use.
						</h2>

						<blockquote class="founder__quote">
							Indian clinics aren't broken because doctors don't care. They're broken because the
							tools they're sold were designed by people who never sat next to a front desk in Patna
							on a Tuesday afternoon.
						</blockquote>

						<div class="founder__bullets" role="list" aria-label="What we believe">
							<div class="founder__bullet">
								<Icon name="check" size={16} />
								<div>
									<strong style="color: var(--ink);">The front desk runs the clinic.</strong>
									Software should respect that — not test the receptionist's patience with the manual.
								</div>
							</div>
							<div class="founder__bullet">
								<Icon name="check" size={16} />
								<div>
									<strong style="color: var(--ink);">Indian context, not Indian feature.</strong>
									Hindi UI, Indian data centres, ABDM, GST e-invoicing — first-class, not bolted on.
								</div>
							</div>
							<div class="founder__bullet">
								<Icon name="check" size={16} />
								<div>
									<strong style="color: var(--ink);">Honesty over polish.</strong>
									If something is broken we name it. If a competitor does it better, we'll tell you.
								</div>
							</div>
							<div class="founder__bullet">
								<Icon name="check" size={16} />
								<div>
									<strong style="color: var(--ink);"
										>Built behind front desks, not behind Figma.</strong
									>
									We rebuild a module after sitting with the staff who use it — not before.
								</div>
							</div>
						</div>

						<div class="founder__sig">
							<div>
								<div class="founder__sig-name">The Lucoze team</div>
								<div class="founder__sig-role">Distributed across India</div>
							</div>
							<a href="/in/about/" class="btn btn--ghost" style="margin-left: auto;">
								About us
								<Icon name="arrow" size={14} class="btn__arrow" />
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- FAQ — <details>/<summary>, no JS -->
		<section class="section" id="faq" aria-labelledby="faq-heading">
			<div class="container">
				<header class="section-header">
					<span class="t-eyebrow">Frequently asked</span>
					<h2 id="faq-heading" class="t-h1" style="margin-top: 8px;">
						The questions every clinic owner asks us.
					</h2>
				</header>
				<Faq items={HOME_FAQS} />
			</div>
		</section>

		<!-- Final CTA -->
		<section class="section" aria-labelledby="cta-heading">
			<div class="container">
				<div class="cta-final">
					<span
						class="t-eyebrow"
						style="color: rgba(244,243,238,0.7); display: inline-block; margin-bottom: var(--s-3);"
					>
						Ready when you are
					</span>
					<h2 id="cta-heading">Try Lucoze with your team for 14 days. Free.</h2>
					<p>
						No credit card. Full feature access. We'll help you import patients from your current
						system in the first week. If it doesn't fit, you owe us nothing.
					</p>
					<div class="cta-final__actions">
						<a href="/in/demo/" class="btn btn--primary btn--lg">
							Book a demo
							<Icon name="arrow" size={16} class="btn__arrow" />
						</a>
						<a href="/in/design-partner/" class="btn btn--ghost btn--lg"> Talk to us </a>
					</div>
				</div>
			</div>
		</section>

		{/* Organization + WebSite schema now emitted site-wide from Base.astro. */}
		<script
			type="application/ld+json"
			slot="head"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "FAQPage",
				mainEntity: HOME_FAQS.map((f) => ({
					"@type": "Question",
					name: f.q,
					acceptedAnswer: { "@type": "Answer", text: f.a },
				})),
			})}
		/>
		{
			/* SoftwareApplication for the product itself, so the homepage (the page
		    most likely to be the entity's canonical result) carries a Product/App
		    node linked to the Organization. Mirrors /in/pricing/. No aggregateRating
		    — we don't fabricate reviews. */
		}
		<script
			type="application/ld+json"
			slot="head"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "SoftwareApplication",
				"@id": "https://lucoze.com/#software",
				name: "Lucoze Healthcare Management Software",
				applicationCategory: "HealthApplication",
				operatingSystem: "Web",
				url: "https://lucoze.com/in/",
				publisher: { "@id": "https://lucoze.com/#organization" },
				offers: [
					{ "@type": "Offer", name: "Clinic", price: "1499", priceCurrency: "INR" },
					{ "@type": "Offer", name: "Clinic Pro", price: "2999", priceCurrency: "INR" },
					{ "@type": "Offer", name: "Hospital", price: "7999", priceCurrency: "INR" },
				],
			})}
		/>
	</section>

	<style>
		.product-preview-placeholder {
			position: relative;
		}
		.product-caption {
			text-align: center;
			font-family: var(--font-serif);
			font-style: italic;
			font-size: clamp(16px, 1.6vw, 19px);
			color: var(--ink);
			max-width: 720px;
			margin: 0 auto var(--s-8);
			line-height: 1.5;
		}
		/* Founder section: two-column 'paired voices' layout. */
		/* Founder section: two-column 'paired voices' layout.
		   LEFT = founder voice (commitments, signed by the founder).
		   RIGHT = team voice (mission + values, signed by the Lucoze team).
		   align-items: start so each column flows from the top — no awkward
		   vertical centring when the columns are different heights. */
		.founder--cards {
			grid-template-columns: 1fr 1fr;
			align-items: start;
		}
		@media (max-width: 880px) {
			.founder--cards {
				grid-template-columns: 1fr;
				gap: var(--s-10);
			}
		}
		.founder__col {
			min-width: 0;
		}
		.founder__sig-avatar {
			width: 64px;
			height: 64px;
			border-radius: 50%;
			object-fit: cover;
			flex-shrink: 0;
			box-shadow: 0 2px 8px rgba(31, 29, 26, 0.1);
			border: 2px solid var(--paper);
			margin-right: 6px;
		}
		.founder__sig-avatar {
			width: 64px;
			height: 64px;
			border-radius: 50%;
			object-fit: cover;
			flex-shrink: 0;
			box-shadow: 0 2px 8px rgba(31, 29, 26, 0.1);
			border: 2px solid var(--paper);
			margin-right: 6px;
		}
	</style>

	<script>
		// SpecialtySwitcher — vanilla JS toggle for the home page Product Preview.
		// Each pill carries its own caption in data-specialty-caption-for so we
		// don't need define:vars (which forces inline non-module emit and breaks
		// ES `import` statements).
		import { track } from "../../lib/analytics";
		document.querySelectorAll<HTMLButtonElement>("[data-specialty-pill]").forEach((pill) => {
			pill.addEventListener("click", () => {
				const id = pill.getAttribute("data-specialty-pill");
				const caption = pill.getAttribute("data-specialty-caption-for");
				document.querySelectorAll("[data-specialty-pill]").forEach((p) => {
					const active = p === pill;
					p.classList.toggle("specialty__btn--active", active);
					p.setAttribute("aria-selected", active ? "true" : "false");
				});
				document.querySelectorAll<HTMLElement>("[data-specialty-visual]").forEach((v) => {
					v.hidden = v.getAttribute("data-specialty-visual") !== id;
				});
				const cap = document.querySelector("[data-specialty-caption]");
				if (cap && caption) cap.textContent = caption;
				if (id) track("Specialty Switch", { to: id });
			});
		});

		// Design partner CTA — fires from any of the home page DP links.
		document
			.querySelectorAll<HTMLAnchorElement>('a[href="/in/design-partner/"]')
			.forEach((a) =>
				a.addEventListener("click", () => track("Design Partner Apply", { source: "home" })),
			);

		// "Explore the platform" module link-out — track which module drew the click.
		document
			.querySelectorAll<HTMLAnchorElement>(".platform-explore a")
			.forEach((a) =>
				a.addEventListener("click", () =>
					track("Platform Explore Click", { module: a.textContent?.trim() || "" }),
				),
			);
	</script>
</Base>
