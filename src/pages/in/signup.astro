---
import Base from "../../layouts/Base.astro";
import Crumbs from "../../components/Crumbs.astro";
import Icon from "../../components/Icon.astro";

const PLANS = [
	{ id: "clinic", name: "Clinic", price: "₹1,499/mo" },
	{ id: "clinicpro", name: "Clinic Pro", price: "₹2,999/mo" },
	{ id: "hospital", name: "Hospital", price: "₹7,999/mo" },
];

const BENEFITS: { title: string; sub: string }[] = [
	{ title: "Full feature access from day one", sub: "Every module. No upsell." },
	{
		title: "Help importing your patient list",
		sub: "From Practo Ray, Halemind, or even Excel.",
	},
	{
		title: "Hindi UI ships Q3 2026",
		sub: "Bengali and Odia next. Already accommodating early Devanagari testing.",
	},
	{
		title: "Founder line, not call centre",
		sub: "WhatsApp Mithun directly during trial.",
	},
];
---

<Base
	title="Start your 14-day free trial of Lucoze HMS"
	description="Free trial of Lucoze Healthcare Management Software. No credit card. Full features. Migration help included. Data hosted in India."
>
	<main class="signup-page">
		<div class="container">
			<Crumbs items={[{ href: "/in/", label: "Home" }, { label: "Start free trial" }]} />
			<div class="signup-page__grid">
				<div>
					<span class="t-eyebrow">14-day free trial · no credit card</span>
					<h1 class="t-h1" style="margin: var(--s-4) 0 var(--s-5);">
						Start running your clinic on Lucoze. In 60 seconds.
					</h1>
					<p class="t-lead">
						Tell us about your clinic. We set up a trial tenant in India, walk your front desk
						through it on a 30-minute call, and you start booking patients within an hour. No credit
						card. No commitment.
					</p>

					<div
						style="display: flex; flex-direction: column; gap: var(--s-4); margin: var(--s-8) 0;"
					>
						{
							BENEFITS.map((b) => (
								<div style="display: flex; gap: var(--s-3);">
									<Icon
										name="check-circle"
										size={20}
										style="color: var(--success); flex-shrink: 0; margin-top: 2px;"
									/>
									<div>
										<div style="font-weight: 700; color: var(--ink);">{b.title}</div>
										<div style="font-size: 13px; color: var(--muted);">{b.sub}</div>
									</div>
								</div>
							))
						}
					</div>

					<div
						style="padding: var(--s-4) var(--s-5); background: var(--paper); border: 1px solid var(--border); border-radius: var(--r-md); font-size: 13px; color: var(--ink-soft); display: flex; gap: 12px; align-items: flex-start;"
					>
						<Icon
							name="cloud"
							size={20}
							style="color: var(--primary); flex-shrink: 0; margin-top: 2px;"
						/>
						<div>
							<strong style="color: var(--ink);">Data hosted in India.</strong> Your patient records sit
							in Indian data centres. Nothing crosses the border.
							<a href="/in/blog/security-data/" style="color: var(--primary); font-weight: 600;"
								>Read more</a
							>
						</div>
					</div>
				</div>

				<div data-signup-wrapper>
					<form class="signup-form" id="signup-form" data-signup-form>
						<h2 class="t-h3" style="margin-bottom: var(--s-2);">Tell us about your clinic</h2>
						<p style="font-size: 13px; color: var(--muted); margin-bottom: var(--s-6);">
							We'll set up a trial tenant within 4 working hours.
						</p>

						<div class="field">
							<label>Which plan? <span class="req">*</span></label>
							<div class="plan-pick" role="radiogroup" aria-label="Plan">
								{
									PLANS.map((p) => (
										<div class="plan-pick__option">
											<input
												type="radio"
												id={`plan-${p.id}`}
												name="plan"
												value={p.id}
												checked={p.id === "clinicpro"}
											/>
											<label for={`plan-${p.id}`}>
												<span class="plan-pick__name">{p.name}</span>
												<span class="plan-pick__price">{p.price}</span>
											</label>
										</div>
									))
								}
							</div>
						</div>

						<div class="field-row">
							<div class="field">
								<label for="su-name">Your name <span class="req">*</span></label>
								<input id="su-name" name="name" required placeholder="Dr. Soumya Sen" />
							</div>
							<div class="field">
								<label for="su-phone">Phone <span class="req">*</span></label>
								<input id="su-phone" name="phone" type="tel" required placeholder="+91 ·····" />
							</div>
						</div>

						<div class="field">
							<label for="su-email">Email <span class="req">*</span></label>
							<input
								id="su-email"
								name="email"
								type="email"
								required
								placeholder="you@clinic.com"
							/>
						</div>

						<div class="field-row">
							<div class="field">
								<label for="su-clinic">
									Clinic / hospital name <span class="req">*</span>
								</label>
								<input
									id="su-clinic"
									name="clinic"
									required
									placeholder="e.g. Sen Multispeciality"
								/>
							</div>
							<div class="field">
								<label for="su-city">City <span class="req">*</span></label>
								<input id="su-city" name="city" required placeholder="Kolkata / Lucknow / Patna…" />
							</div>
						</div>

						<div class="field-row">
							<div class="field">
								<label for="su-doctors">Doctors</label>
								<input
									id="su-doctors"
									name="doctors"
									type="number"
									min="1"
									max="200"
									placeholder="6"
								/>
							</div>
							<div class="field">
								<label for="su-specialty">Specialty</label>
								<select id="su-specialty" name="specialty">
									<option value="multispec">Multi-specialty</option>
									<option value="poly">Polyclinic</option>
									<option value="dental">Dental</option>
									<option value="ivf">IVF</option>
									<option value="derm">Dermatology</option>
									<option value="diag">Diagnostic centre</option>
									<option value="other">Other</option>
								</select>
							</div>
						</div>

						<button
							type="submit"
							class="btn btn--accent btn--lg signup-form__submit"
							data-signup-submit
						>
							<span data-signup-submit-label>Start free trial</span>
							<Icon name="arrow" size={16} class="btn__arrow" />
						</button>

						<p
							data-signup-error
							hidden
							role="alert"
							style="margin-top: var(--s-3); padding: 10px 12px; background: var(--error-bg, rgba(177,52,42,0.08)); border: 1px solid var(--error); color: var(--error); border-radius: var(--r-sm); font-size: 13px; text-align: center;"
						>
						</p>

						<p
							style="font-size: 11px; color: var(--light); margin-top: var(--s-3); text-align: center;"
						>
							By signing up, you agree to our
							<a href="/in/terms/" style="color: var(--primary);">Terms</a> and
							<a href="/in/privacy/" style="color: var(--primary);">Privacy Policy</a>.
							DPDP-compliant from day one.
						</p>
					</form>

					<form class="signup-form" id="signup-otp" data-signup-otp hidden>
						<span class="t-eyebrow">Verify your email</span>
						<h2 class="t-h3" style="margin: var(--s-3) 0 var(--s-3);">Enter the 6-digit code</h2>
						<p style="font-size: 14px; color: var(--muted); line-height: 1.6;">
							We emailed a code to <strong data-otp-email>your email</strong>. It expires in 10
							minutes.
						</p>

						<div class="field" style="margin-top: var(--s-4);">
							<label for="su-otp">Verification code <span class="req">*</span></label>
							<input
								id="su-otp"
								name="otp"
								inputmode="numeric"
								pattern="[0-9]{6}"
								maxlength="6"
								required
								autocomplete="one-time-code"
								placeholder="······"
								style="letter-spacing: 0.4em; text-align: center; font-size: 20px;"
							/>
						</div>

						<button
							type="submit"
							class="btn btn--accent btn--lg signup-form__submit"
							data-otp-submit
						>
							<span data-otp-submit-label>Verify &amp; create trial</span>
							<Icon name="arrow" size={16} class="btn__arrow" />
						</button>

						<p
							data-otp-error
							hidden
							role="alert"
							style="margin-top: var(--s-3); padding: 10px 12px; background: var(--error-bg, rgba(177,52,42,0.08)); border: 1px solid var(--error); color: var(--error); border-radius: var(--r-sm); font-size: 13px; text-align: center;"
						>
						</p>

						<p
							style="font-size: 12px; color: var(--light); margin-top: var(--s-4); text-align: center;"
						>
							Didn't get it?
							<button
								type="button"
								data-otp-resend
								style="background: none; border: none; padding: 0; color: var(--primary); cursor: pointer; font: inherit; text-decoration: underline; text-underline-offset: 2px;"
							>
								Resend code
							</button>
						</p>
					</form>

					<div
						class="signup-form"
						id="signup-thanks"
						data-signup-thanks
						hidden
						style="text-align: center;"
					>
						<div
							style="width: 64px; height: 64px; margin: 0 auto var(--s-5); border-radius: 50%; background: var(--success-bg); color: var(--success); display: grid; place-items: center;"
						>
							<Icon name="check" size={28} />
						</div>
						<span class="t-eyebrow">You're in</span>
						<h2 class="t-h3" style="margin: var(--s-3) 0 var(--s-3);">
							Thanks, <span data-signup-thanks-name>doctor</span>. We'll reach out within 4 hours.
						</h2>
						<p style="font-size: 14px; color: var(--muted); line-height: 1.6;">
							Your trial is being provisioned in India. You'll get an email with login details and a
							WhatsApp from our onboarding lead. If you're East-India and fit the design-partner
							profile, we'll mention that too.
						</p>
						<div
							style="display: flex; gap: 10px; justify-content: center; margin-top: var(--s-5); flex-wrap: wrap;"
						>
							<a href="/in/blog/" class="btn btn--ghost">Read the blog</a>
							<a href="/in/" class="btn btn--accent">Back to home</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>
</Base>

<script>
	import { track } from "../../lib/analytics";

	// LucozeTracker is loaded as a classic deferred script in Base.astro
	// (/public/js/tracker.js). Module scripts run after classic deferred
	// scripts, so the global is available by the time this code executes.
	type LucozeTrackerGlobal = {
		trackFormField?: (field: string, value: string) => void;
		trackFormAbandon?: () => void;
	};
	const getTracker = (): LucozeTrackerGlobal | undefined =>
		(window as unknown as { LucozeTracker?: LucozeTrackerGlobal }).LucozeTracker;

	// SignupForm — two-step OTP signup wired to lucoze_admin's provisioning API.
	//
	// Flow:
	//   1. User fills the form → POST initiate_signup → admin emails a 6-digit OTP.
	//   2. OTP panel appears → POST verify_signup → admin creates the
	//      Provisioning Request (Pending) → admin approves → agent provisions.
	//
	// Endpoint base comes from PUBLIC_ADMIN_API_URL at build time (the admin
	// site for the target environment). If unset (pre-launch), the form skips
	// the network and shows the thanks panel directly.
	const ADMIN = import.meta.env.PUBLIC_ADMIN_API_URL as string | undefined;

	// Form plan ids → admin plan names (admin VALID_PLANS).
	const PLAN_MAP: Record<string, string> = {
		clinic: "Clinic",
		clinicpro: "Clinic Pro",
		hospital: "Hospital",
	};

	const form = document.querySelector<HTMLFormElement>("[data-signup-form]");
	const otpForm = document.querySelector<HTMLFormElement>("[data-signup-otp]");
	const thanks = document.querySelector<HTMLElement>("[data-signup-thanks]");
	const thanksName = document.querySelector<HTMLElement>("[data-signup-thanks-name]");
	const submitBtn = document.querySelector<HTMLButtonElement>("[data-signup-submit]");
	const submitLabel = document.querySelector<HTMLElement>("[data-signup-submit-label]");
	const errorEl = document.querySelector<HTMLElement>("[data-signup-error]");
	const otpEmailEl = document.querySelector<HTMLElement>("[data-otp-email]");
	const otpInput = document.querySelector<HTMLInputElement>("#su-otp");
	const otpBtn = document.querySelector<HTMLButtonElement>("[data-otp-submit]");
	const otpLabel = document.querySelector<HTMLElement>("[data-otp-submit-label]");
	const otpError = document.querySelector<HTMLElement>("[data-otp-error]");
	const otpResend = document.querySelector<HTMLButtonElement>("[data-otp-resend]");

	// Carried from step 1 to step 2.
	let pendingEmail = "";
	let pendingFirstName = "doctor";

	// Preselect the plan radio from ?plan=clinic|clinicpro|hospital query param.
	const planParam = new URLSearchParams(window.location.search).get("plan");
	if (planParam && ["clinic", "clinicpro", "hospital"].includes(planParam)) {
		const radio = document.querySelector<HTMLInputElement>(
			`input[name="plan"][value="${planParam}"]`,
		);
		if (radio) radio.checked = true;
	}

	const showError = (msg: string) => {
		if (!errorEl) return;
		errorEl.textContent = msg;
		errorEl.hidden = false;
	};
	const clearError = () => {
		if (errorEl) errorEl.hidden = true;
	};
	const showOtpError = (msg: string) => {
		if (!otpError) return;
		otpError.textContent = msg;
		otpError.hidden = false;
	};
	const clearOtpError = () => {
		if (otpError) otpError.hidden = true;
	};
	const setLoading = (loading: boolean) => {
		if (submitBtn) submitBtn.disabled = loading;
		if (submitLabel)
			submitLabel.textContent = loading ? "Sending verification code…" : "Start free trial";
	};
	const setOtpLoading = (loading: boolean) => {
		if (otpBtn) otpBtn.disabled = loading;
		if (otpLabel) otpLabel.textContent = loading ? "Creating your trial…" : "Verify & create trial";
	};
	const showThanks = (firstName: string) => {
		if (thanksName) thanksName.textContent = firstName;
		if (form) {
			form.hidden = true;
			// Mark form as completed so the beforeunload handler below
			// doesn't fire trackFormAbandon when the user closes the tab
			// after a successful signup.
			form.dataset.submitted = "true";
		}
		if (otpForm) otpForm.hidden = true;
		if (thanks) {
			thanks.hidden = false;
			thanks.scrollIntoView({ behavior: "smooth", block: "center" });
		}
	};
	const showOtpPanel = () => {
		if (otpEmailEl) otpEmailEl.textContent = pendingEmail;
		if (form) form.hidden = true;
		if (otpForm) {
			otpForm.hidden = false;
			otpForm.scrollIntoView({ behavior: "smooth", block: "center" });
		}
		if (otpInput) otpInput.focus();
	};

	// Pulls a clean message out of a Frappe error response. Frappe puts
	// frappe.throw() text in _server_messages (a JSON string of JSON strings).
	const extractError = (data: any, status: number): string => {
		try {
			if (data && data._server_messages) {
				const arr = JSON.parse(data._server_messages);
				const first = JSON.parse(arr[0]);
				return first.message || String(first);
			}
		} catch {
			/* fall through to generic */
		}
		return (data && (data.message || data.exception)) || `Request failed (${status}).`;
	};

	// Calls a whitelisted Frappe method on the admin site. allow_guest endpoints,
	// so no auth/CSRF; CORS for this origin is configured on the admin side.
	const callMethod = async (method: string, payload: Record<string, unknown>) => {
		const res = await fetch(`${ADMIN}/api/method/${method}`, {
			method: "POST",
			headers: { "Content-Type": "application/json", Accept: "application/json" },
			body: JSON.stringify(payload),
		});
		let data: any = {};
		try {
			data = await res.json();
		} catch {
			/* non-JSON response */
		}
		if (!res.ok) throw new Error(extractError(data, res.status));
		return data.message;
	};

	// Signup Form Started — first field focus on the form.
	if (form) {
		let startedFired = false;
		form.addEventListener(
			"focusin",
			() => {
				if (startedFired) return;
				startedFired = true;
				const plan =
					form.querySelector<HTMLInputElement>('input[name="plan"]:checked')?.value || "unknown";
				track("Signup Form Started", { plan });
			},
			{ once: false },
		);
	}

	// LucozeTracker integration — feeds partial form values into the
	// admin.lucoze.com visitor pipeline. Form-field name mapping converts
	// this page's input names to the keys lucoze_admin.api.tracking.FORM_FIELD_MAP
	// already understands (rest are silently dropped server-side).
	if (form) {
		const FIELD_MAP: Record<string, string> = {
			name: "customer_name",
			phone: "phone",
			email: "email",
			clinic: "facility_name",
		};

		for (const [inputName, mappedName] of Object.entries(FIELD_MAP)) {
			const input = form.querySelector<HTMLInputElement>(`[name="${inputName}"]`);
			if (!input) continue;
			input.addEventListener("blur", () => {
				const v = input.value.trim();
				if (v) getTracker()?.trackFormField?.(mappedName, v);
			});
		}

		// Plan radio change — fires trackFormField("plan", <plan-id>).
		form.querySelectorAll<HTMLInputElement>('input[name="plan"]').forEach((radio) => {
			radio.addEventListener("change", () => {
				if (radio.checked && radio.value) getTracker()?.trackFormField?.("plan", radio.value);
			});
		});

		// Form abandon — if user touched the form but never reached the
		// thanks panel, send trackFormAbandon on tab close. The dataset.submitted
		// flag is set in showThanks() to suppress this on success.
		let formInteracted = false;
		form.addEventListener("input", () => {
			formInteracted = true;
		});
		window.addEventListener("beforeunload", () => {
			if (formInteracted && form.dataset.submitted !== "true") {
				getTracker()?.trackFormAbandon?.();
			}
		});
	}

	// Step 1 — collect details, request OTP.
	if (form) {
		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			clearError();
			if (!form.reportValidity()) {
				track("Signup Error", { reason: "validation" });
				return;
			}

			const fd = new FormData(form);
			const planId = (fd.get("plan") as string | null) || "clinicpro";
			pendingEmail = ((fd.get("email") as string | null) || "").trim();
			pendingFirstName =
				((fd.get("name") as string | null) || "").trim().split(/\s+/)[0] || "doctor";
			const specialty = (fd.get("specialty") as string | null) || "unknown";

			// customer_name becomes the tenant site slug, so it's the FACILITY
			// (clinic) name, not the contact person's name.
			const payload = {
				customer_name: ((fd.get("clinic") as string | null) || "").trim(),
				customer_email: pendingEmail,
				plan: PLAN_MAP[planId] || "Clinic Pro",
				country: "India",
				currency: "INR",
				customer_phone: ((fd.get("phone") as string | null) || "").trim() || null,
			};

			// Pre-launch (no admin URL configured): skip network, show thanks.
			if (!ADMIN) {
				track("Signup Submitted", { plan: planId, specialty });
				showThanks(pendingFirstName);
				return;
			}

			setLoading(true);
			try {
				await callMethod("lucoze_admin.api.provisioning.initiate_signup", payload);
				track("Signup OTP Sent", { plan: planId, specialty });
				showOtpPanel();
			} catch (err) {
				showError(
					err instanceof Error
						? err.message
						: "Couldn't reach the signup server. Try again, or email hello@lucoze.com.",
				);
				track("Signup Error", { reason: err instanceof Error ? "server" : "network" });
			} finally {
				setLoading(false);
			}
		});
	}

	// Step 2 — verify OTP, which creates the provisioning request.
	if (otpForm) {
		otpForm.addEventListener("submit", async (e) => {
			e.preventDefault();
			clearOtpError();
			if (!otpForm.reportValidity()) return;
			const code = (otpInput?.value || "").trim();

			setOtpLoading(true);
			try {
				await callMethod("lucoze_admin.api.provisioning.verify_signup", {
					customer_email: pendingEmail,
					otp_code: code,
				});
				track("Signup Verified", {});
				showThanks(pendingFirstName);
			} catch (err) {
				showOtpError(
					err instanceof Error ? err.message : "Couldn't verify the code. Please try again.",
				);
			} finally {
				setOtpLoading(false);
			}
		});
	}

	// Resend OTP.
	if (otpResend) {
		otpResend.addEventListener("click", async () => {
			clearOtpError();
			if (!ADMIN || !pendingEmail) return;
			try {
				await callMethod("lucoze_admin.api.provisioning.resend_otp", {
					customer_email: pendingEmail,
				});
				showOtpError("A new code has been sent to your email.");
			} catch (err) {
				showOtpError(err instanceof Error ? err.message : "Couldn't resend. Please try again.");
			}
		});
	}
</script>
