---
import Base from "../../../layouts/Base.astro";
import SubHero from "../../../components/SubHero.astro";
import FRow from "../../../components/FRow.astro";
import VisualPlaceholder from "../../../components/VisualPlaceholder.astro";
import Icon from "../../../components/Icon.astro";
import Screenshot from "../../../components/Screenshot.astro";
import { SPECIALTIES } from "../../../data/specialties-list.ts";

const MODULES: { icon: string; title: string; blurb: string; href: string }[] = [
	{
		icon: "calendar",
		title: "Appointments",
		blurb: "Department-first booking flow with WhatsApp + SMS reminders",
		href: "/in/features/appointments/",
	},
	{
		icon: "users",
		title: "Patient records",
		blurb: "One timeline, family-linked, ABHA-ready",
		href: "/in/features/patient-records/",
	},
	{
		icon: "receipt",
		title: "Billing + GST",
		blurb: "Multi-doctor invoicing, GSTR-1 / 3B exports",
		href: "/in/features/billing/",
	},
	{
		icon: "flask",
		title: "Lab module",
		blurb: "In-house + outsourced, NABL-ready audit trail",
		href: "/in/features/lab/",
	},
	{
		icon: "pill",
		title: "Pharmacy",
		blurb: "Prescription → dispense → stock, all in one chain",
		href: "/in/features/pharmacy/",
	},
	{
		icon: "users",
		title: "HR + payroll",
		blurb: "Attendance, leave, statutory deductions",
		href: "/in/features/hr/",
	},
];
---

<Base
	title="Clinic Management Software for Indian multi-doctor practices"
	description="Lucoze HMS for 1-15 doctor clinics. Appointments, patient records, GST billing, lab, pharmacy. Hindi UI. Live in 14 days."
>
	<SubHero
		crumbs={[
			{ href: "/in/", label: "Home" },
			{ href: "/in/solutions/", label: "Solutions" },
			{ label: "Clinics" },
		]}
		eyebrow="For clinics · 1-15 doctors"
		h1="Built for the way Indian clinics actually run."
		highlightParts={["Built for the way ", "Indian clinics actually run", "."]}
		lead="From a solo clinic in Patna to a 12-doctor multi-specialty in Kolkata — Lucoze gives you appointments, records, billing, lab, and pharmacy on one platform. Hindi-first. India-hosted. Live in 14 days."
		primaryCta={{ href: "/in/demo/", label: "Book a demo" }}
		secondaryCta={{ href: "/in/contact/", label: "Book a walkthrough" }}
		statsRow={[
			{ value: "14 days", label: "From signup to live" },
			{ value: "Hindi", label: "Native UI (Bengali next)" },
			{ value: "India", label: "Data residency" },
			{ value: "0%", label: "Per-user pricing tricks" },
		]}
	>
		<Screenshot
			slot="visual"
			name="front-office"
			alt="Lucoze front office and OPD queue for an Indian clinic"
		/>
	</SubHero>

	<section class="section section--tight">
		<div class="container">
			<header class="section-header section-header--left">
				<span class="t-eyebrow">What's included</span>
				<h2 class="t-h2" style="margin-top: 8px;">Every module a multi-doctor clinic needs.</h2>
				<p class="t-lead" style="margin-top: var(--s-3);">
					No paid add-ons. No upsell paths. The Clinic Pro plan ships with everything below,
					configured for your specialty.
				</p>
			</header>

			<div class="module-grid">
				{
					MODULES.map((m) => (
						<a href={m.href} class="module-card">
							<div class="module-card__icon">
								<Icon name={m.icon} size={20} />
							</div>
							<div class="module-card__title">{m.title}</div>
							<div class="module-card__blurb">{m.blurb}</div>
							<div class="module-card__arrow">
								Learn more
								<Icon name="arrow" size={12} />
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section--tight">
		<div class="container">
			<FRow
				eyebrow="The clinic owner's promise"
				title="No lock-in. Your data exports on demand."
				lead="Your patient records, appointment history, billing, prescriptions — all of it exports to CSV and PDF within 24 hours of a request. We'd rather lose you than trap you."
				bullets={[
					"Patient records, prescriptions, lab reports — PDF, with timestamps and signatures preserved.",
					"Appointment history + billing — CSV, ready for Tally or any accounting tool.",
					"30-day grace period after cancellation so you can pull everything cleanly.",
					"Full data exports during your trial — even before you've paid for a single month.",
				]}
			>
				<VisualPlaceholder slot="visual">
					<Icon name="lock" size={56} style="color: var(--primary); opacity: 0.5;" />
					<strong style="color: var(--ink); font-size: 14px; margin-top: 12px;">
						Your data, your control
					</strong>
					<span style="font-size: 12px; color: var(--muted);">CSV + PDF export anytime</span>
				</VisualPlaceholder>
			</FRow>

			<FRow
				eyebrow="Switching is the hard part"
				title="We move you off Practo Ray / Halemind in 14 days."
				lead="Migration is included. Patient master, appointments, billing history — we import what we can validate, archive the rest. You run both systems in parallel for the first week. By week two, the old tool is read-only."
				bullets={[
					"Patient master + appointment history imported and validated against your old system.",
					"Active bookings rolled forward with WhatsApp confirmations to patients.",
					"Past clinical notes preserved as searchable PDFs alongside new fully-structured notes.",
					"Implementation runs in parallel — you keep working, no clinic downtime.",
				]}
				flip
			>
				<VisualPlaceholder slot="visual">
					<Icon name="arrow" size={56} style="color: var(--primary); opacity: 0.5;" />
					<strong style="color: var(--ink); font-size: 14px; margin-top: 12px;">
						14-day migration
					</strong>
					<a
						href="/in/blog/switch-from-practo-ray/"
						style="font-size: 12px; color: var(--primary); font-weight: 600;"
					>
						Read the plan →
					</a>
				</VisualPlaceholder>
			</FRow>

			<FRow
				eyebrow="What you save"
				title="A clinic with 6 doctors saves ₹4-6 lakhs a month."
				lead="The savings aren't from cheaper software — they're from less staff time on reconciliation, fewer billing leaks, and no-show prevention. The full breakdown is on our calculator."
				bullets={[
					"100+ admin hours per month, recovered.",
					"5-7% no-show prevention from WhatsApp reminders.",
					"Billing leakage from missed items + lost discounts: typically ₹1L+/mo at 6 doctors.",
					"Pharmacy stock-outs and expiry waste: cut by 60-80% with batch tracking.",
				]}
			>
				<VisualPlaceholder slot="visual">
					<Icon name="chart" size={56} style="color: var(--primary); opacity: 0.5;" />
					<strong style="color: var(--ink); font-size: 14px; margin-top: 12px;">
						ROI calculator
					</strong>
					<a href="/in/#roi" style="font-size: 12px; color: var(--primary); font-weight: 600;">
						See it on the home page →
					</a>
				</VisualPlaceholder>
			</FRow>
		</div>
	</section>

	<section class="section section--tight">
		<div class="container">
			<header class="section-header">
				<span class="t-eyebrow">By specialty</span>
				<h2 class="t-h2" style="margin-top: 8px;">Pick yours. We've built the workflows.</h2>
			</header>
			<div class="module-grid">
				{
					SPECIALTIES.map((s) => (
						<a href={`/in/specialties/${s.slug}/`} class="module-card">
							<div class="module-card__icon">
								<Icon name={s.icon} size={20} />
							</div>
							<div class="module-card__title">{s.label}</div>
							<div class="module-card__blurb">{s.blurb}</div>
							<div class="module-card__arrow">
								View workflow
								<Icon name="arrow" size={12} />
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="cta-final" style="padding: var(--s-12) var(--s-8);">
				<h2 style="font-size: clamp(24px, 3vw, 36px); margin-bottom: var(--s-3);">
					Try Lucoze for your clinic. 14 days. Free.
				</h2>
				<p>
					No credit card. We help you import patients from your current system in the first week.
				</p>
				<div class="cta-final__actions">
					<a href="/in/demo/" class="btn btn--primary btn--lg">
						Book a demo
						<Icon name="arrow" size={16} class="btn__arrow" />
					</a>
					<a href="/in/design-partner/" class="btn btn--ghost btn--lg"> Apply as design partner </a>
				</div>
			</div>
		</div>
	</section>
</Base>
