---
import Base from "../../../layouts/Base.astro";
import SubHero from "../../../components/SubHero.astro";
import FRow from "../../../components/FRow.astro";
import VisualPlaceholder from "../../../components/VisualPlaceholder.astro";
import Icon from "../../../components/Icon.astro";
import Screenshot from "../../../components/Screenshot.astro";
import ProductGalleries from "../../../components/ProductGalleries.astro";
import { Image } from "astro:assets";
import { screenshotByName } from "../../../lib/screenshots";
import { GALLERIES } from "../../../data/flow-galleries";

// "What you get" merged with "a look inside": a module carrying a `gallery` id
// becomes a clickable card that opens that flow's screens. NABH + ABDM have no
// screens, so they stay static info cards.
const HOSP_MODULES: { icon: string; title: string; blurb: string; gallery?: string }[] = [
	{
		icon: "home",
		title: "Inpatient + wards",
		blurb: "Bed map, admission to discharge, IPD billing",
		gallery: "ipd",
	},
	{
		icon: "calendar",
		title: "OT scheduling",
		blurb: "Surgery slots reserve staff + consumables + post-op",
		gallery: "ot",
	},
	{
		icon: "receipt",
		title: "Hospital billing",
		blurb: "Department-level, consolidated, e-invoiced",
		gallery: "billing",
	},
	{
		icon: "flask",
		title: "Lab + radiology",
		blurb: "Sample to report, NABL-ready, outsource handling",
		gallery: "lab",
	},
	{
		icon: "pill",
		title: "Hospital pharmacy",
		blurb: "Schedule-H/X, multi-store, batch tracking",
		gallery: "pharmacy",
	},
	{
		icon: "activity",
		title: "Emergency & casualty",
		blurb: "Fast intake, active cases, disposition",
		gallery: "emergency",
	},
	{
		icon: "book",
		title: "Insurance & TPA",
		blurb: "Cashless pre-auth, claims, settlement",
		gallery: "insurance",
	},
	{
		icon: "users",
		title: "HR + payroll",
		blurb: "30+ staff, doctor incentives, statutory deductions",
		gallery: "hr",
	},
	{
		icon: "chart",
		title: "NABH dashboards",
		blurb: "ALOS, infection rates, medication errors, audit-ready",
	},
	{
		icon: "shield",
		title: "ABDM integration",
		blurb: "HFR registered facility, ABHA-linked records",
	},
];
const galleryIds = HOSP_MODULES.map((m) => m.gallery).filter((g): g is string => !!g);

// The worked example. Google left this page "crawled, not indexed" (1 Oct 2026) while it
// read as a feature list every HMS publishes; this is the part nobody else can write.
// Every figure is from the marketing vault (concepts/*, verified 24 Jul 2026) — change it
// there first. It is an EXAMPLE, labelled as one: no customer, no invented result.
const SWITCH_STEPS: { title: string; body: string }[] = [
	{
		title: "Nothing goes dark.",
		body: "The current system stays live. We import the patient master, rate cards, formulary and current stock, with no migration fee.",
	},
	{
		title: "Start where it hurts most.",
		body: "Often the pharmacy. Since 22 September 2025 most medicines are taxed at 5% instead of 12%, and some at nil. The rate follows each medicine's HSN code, so a counter billing one flat rate is wrong on part of the shelf. Fix that first, prove it, then expand.",
	},
	{
		title: "Run both side by side.",
		body: "Around days 15 to 30, OPD goes live on Lucoze while IPD shadows it. Compare the two systems' daily totals until they agree, and move on only when they do.",
	},
	{
		title: "Register for ABDM properly.",
		body: "Three separate registrations: the facility on HFR, each doctor on HPR, and an ABHA created or linked at the front desk for each patient. We walk your team through all three, because software alone does not register you.",
	},
	{
		title: "Cut over when you trust it.",
		body: "IPD, OT, pharmacy and lab move one at a time, and the old system becomes read-only around day 45. HR, payroll and the NABH reports close the 60 days. You can export all your data at any time: being free to leave is what makes it safe to join.",
	},
];
---

<Base
	title="Hospital Management Software for 20-100 bed hospitals in India"
	description="Hospital management software for 20-100 bed hospitals in India: ABDM (HFR, HPR, ABHA), GST-correct pharmacy billing, a parallel-run switch with no migration fee, and data hosted in India."
>
	<SubHero
		crumbs={[
			{ href: "/in/", label: "Home" },
			{ href: "/in/solutions/", label: "Solutions" },
			{ label: "Hospitals" },
		]}
		eyebrow="For 20-100 bed hospitals"
		h1="The hospital stack that doesn't take 6 months to deploy."
		highlightParts={["The hospital stack that doesn't ", "take 6 months", " to deploy."]}
		lead="IPD, OPD, OT, lab, pharmacy, HR, NABH-ready dashboards. A small-hospital implementation that runs in 60 days, not 12 months. Built around the way East-India hospitals procure, deploy, and report."
		primaryCta={{ href: "/in/contact/", label: "Book a hospital demo" }}
		secondaryCta={{ href: "/in/blog/abdm-abha-guide/", label: "ABDM readiness guide" }}
		statsRow={[
			{ value: "60 days", label: "Implementation timeline" },
			{ value: "NABH", label: "Audit-ready dashboards" },
			{ value: "Per-bed", label: "Custom pricing" },
			{ value: "India", label: "Data residency" },
		]}
	>
		<Screenshot
			slot="visual"
			name="ipd-beds"
			alt="Lucoze IPD bed planning and ward management for a small hospital"
		/>
	</SubHero>

	<section class="section section--tight">
		<div class="container">
			<header class="section-header section-header--left">
				<span class="t-eyebrow">What you get</span>
				<h2 class="t-h2" style="margin-top: 8px;">
					Everything a 20-100 bed hospital actually runs on.
				</h2>
				<p class="t-lead">Tap any module to step through a few real screens.</p>
			</header>
			<div class="module-grid">
				{
					HOSP_MODULES.map((m) => {
						const g = m.gallery ? GALLERIES[m.gallery] : null;
						const cover = g ? screenshotByName[g.shots[0].name] : null;
						if (g && cover) {
							return (
								<button
									type="button"
									class="module-card module-card--shot"
									data-gallery-open={m.gallery}
									aria-label={`${m.title} — see ${g.shots.length} screens`}
								>
									<span class="module-card__shot">
										<Image
											src={cover}
											alt={g.shots[0].alt}
											widths={[380, 760]}
											sizes="(max-width: 900px) 50vw, 300px"
											quality={78}
											loading="lazy"
										/>
										<span class="module-card__shot-badge">{g.shots.length} screens</span>
									</span>
									<span class="module-card__body">
										<span class="module-card__icon">
											<Icon name={m.icon} size={20} />
										</span>
										<span class="module-card__title">{m.title}</span>
										<span class="module-card__blurb">{m.blurb}</span>
									</span>
								</button>
							);
						}
						return (
							<article class="module-card">
								<div class="module-card__icon">
									<Icon name={m.icon} size={20} />
								</div>
								<div class="module-card__title">{m.title}</div>
								<div class="module-card__blurb">{m.blurb}</div>
							</article>
						);
					})
				}
			</div>
			<ProductGalleries flows={galleryIds} tiles={false} />
		</div>
	</section>

	<section class="section section--tight">
		<div class="container">
			<FRow
				eyebrow="Why hospitals move now"
				title="Your current system was built before these rules."
				lead="Hospitals rarely switch for a nicer screen. They switch because the rules changed and the old system did not keep up. These are the ones a 20-100 bed hospital meets this year."
				bullets={[
					"ABDM: 'ABDM-ready' is a claim. The proof is three registrations: the facility on HFR, each doctor on HPR, and ABHA at the front desk. Lucoze carries all three.",
					"GST on medicines: since 22 September 2025 most medicines are 5% (down from 12%) and some are nil. The rate follows the HSN code, so one flat pharmacy rate is wrong.",
					"E-invoicing: mandatory once a GSTIN's aggregate turnover crosses ₹5 crore. Pharmacy, lab and OPD together often cross it, even when no single counter looks large.",
					"NABH and PM-JAY: accredited hospitals earn 10% (entry-level NABH) or 15% (full NABH) above the PM-JAY package rate, on every scheme case.",
					"DPDP Act 2023: consent, retention and a breach process for patient data. All Lucoze data stays in Indian data centres.",
				]}
			>
				<VisualPlaceholder slot="visual">
					<Icon name="shield" size={56} style="color: var(--primary); opacity: 0.5;" />
					<strong style="color: var(--ink); font-size: 14px; margin-top: 12px;">
						The reasons to move now
					</strong>
					<a
						href="/in/blog/abdm-abha-guide/"
						style="font-size: 12px; color: var(--primary); font-weight: 600;"
					>
						ABDM readiness guide →
					</a>
				</VisualPlaceholder>
			</FRow>
		</div>
	</section>

	<section class="section section--tight">
		<div class="container">
			<header class="section-header section-header--left">
				<span class="t-eyebrow">A worked example</span>
				<h2 class="t-h2 switch-heading">What switching looks like for a 50-bed hospital.</h2>
				<p class="t-lead">
					An example, not a customer story: a 50-bed multispecialty hospital with OPD, IPD, an OT,
					an in-house pharmacy and a lab, already running an older hospital system.
				</p>
			</header>
			<ol class="switch-steps" role="list">
				{
					SWITCH_STEPS.map((step, i) => (
						<li class="switch-step">
							<span class="switch-step__n" aria-hidden="true">{i + 1}</span>
							<div>
								<h3 class="switch-step__title">{step.title}</h3>
								<p class="switch-step__body">{step.body}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="section section--tight">
		<div class="container">
			<FRow
				eyebrow="What moves, what stays"
				title="What moves, what stays, and what you can take with you."
				lead="Most small hospitals run on 3-7 separate tools. Lucoze brings the hospital side into one place, so your administrator stops being the link between them, and leaves your accounts where they are."
				bullets={[
					"Moves: the hospital system, the separate pharmacy and billing software, and the HR spreadsheets.",
					"Stays: Tally or Zoho Books for accounting (we export to them), your bank, your insurance partners.",
					"Migrates, with no migration fee: 5 years of patient master, the last 18 months of appointments and billing, current inventory and HR.",
					"Doesn't migrate: old physical case sheets stay archived; we index them.",
					"Free to leave: export all your data at any time. No lock-in.",
				]}
				flip
			>
				<VisualPlaceholder slot="visual">
					<Icon name="chart" size={56} style="color: var(--primary); opacity: 0.5;" />
					<strong style="color: var(--ink); font-size: 14px; margin-top: 12px;">
						One ledger
					</strong>
				</VisualPlaceholder>
			</FRow>

		</div>
	</section>

	<section
		class="section section--tight"
		style="background: var(--paper); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);"
	>
		<div class="container">
			<header class="section-header">
				<span class="t-eyebrow">Plan that fits</span>
				<h2 class="t-h2" style="margin-top: 8px;">Hospital plan.</h2>
				<p class="t-lead" style="margin-top: var(--s-3);">
					All modules included. Implementation manager for 60 days. Dedicated CSM thereafter.
					<a href="/in/pricing/" style="color: var(--primary); font-weight: 600;">See pricing →</a>
				</p>
			</header>
			<div style="display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
				<a href="/in/contact/" class="btn btn--accent btn--lg">
					Book hospital demo
					<Icon name="arrow" size={16} class="btn__arrow" />
				</a>
				<a href="/in/design-partner/" class="btn btn--ghost btn--lg">
					Design-partner application
				</a>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="cta-final" style="padding: var(--s-12) var(--s-8);">
				<h2 style="font-size: clamp(24px, 3vw, 36px); margin-bottom: var(--s-3);">
					Walk us through your hospital. We'll show you ours.
				</h2>
				<p>30-minute call. We bring our medical director, you bring yours. No pitch deck.</p>
				<div class="cta-final__actions">
					<a href="/in/contact/" class="btn btn--primary btn--lg">
						Book a call
						<Icon name="arrow" size={16} class="btn__arrow" />
					</a>
				</div>
			</div>
		</div>
	</section>
</Base>
