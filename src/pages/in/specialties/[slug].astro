---
import { getCollection, getEntry } from "astro:content";
import Base from "../../../layouts/Base.astro";
import SubHero from "../../../components/SubHero.astro";
import Icon from "../../../components/Icon.astro";
import SpecialtyVisual from "../../../components/visuals/SpecialtyVisual.astro";
import Faq from "../../../components/Faq.astro";

export async function getStaticPaths() {
	const specialties = await getCollection("specialties");
	return specialties.map((entry) => ({
		params: { slug: entry.data.slug },
	}));
}

const { slug } = Astro.params;
const entry = await getEntry("specialties", slug!);
if (!entry) {
	return Astro.redirect("/404");
}
const sp = entry.data;

const WHY_ICONS = ["check", "spark", "shield", "cloud", "users", "chart"];

// BreadcrumbList is already emitted by SubHero → Crumbs; add Service + FAQPage.
const siteUrl = (Astro.site?.toString() ?? "https://lucoze.com/").replace(/\/$/, "");
const pageUrl = `${siteUrl}${Astro.url.pathname}`;
const serviceLd = {
	"@context": "https://schema.org",
	"@type": "Service",
	name: `Lucoze for ${sp.label}`,
	serviceType: "Healthcare management software",
	description: sp.lead,
	provider: { "@id": `${siteUrl}/#organization` },
	areaServed: { "@type": "Country", name: "India" },
	url: pageUrl,
};
const faqLd =
	sp.faqs.length > 0
		? {
				"@context": "https://schema.org",
				"@type": "FAQPage",
				mainEntity: sp.faqs.map((f) => ({
					"@type": "Question",
					name: f.q,
					acceptedAnswer: { "@type": "Answer", text: f.a },
				})),
			}
		: null;
---

<Base title={`${sp.label} management software | Lucoze HMS`} description={sp.lead.slice(0, 160)}>
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(serviceLd)} />
	{faqLd && <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqLd)} />}
	<SubHero
		crumbs={[
			{ href: "/in/", label: "Home" },
			{ href: "/in/solutions/", label: "Solutions" },
			{ label: sp.label },
		]}
		eyebrow={sp.eyebrow}
		h1={sp.h1Parts.join("")}
		highlightParts={sp.h1Parts}
		lead={sp.lead}
		primaryCta={{ href: "/in/demo/", label: "Book a demo" }}
		secondaryCta={{ href: "/in/contact/", label: "Book a walkthrough" }}
	/>

	<section class="section section--tight">
		<div class="container">
			<header class="section-header section-header--left">
				<span class="t-eyebrow">Why Lucoze fits {sp.label}</span>
				<h2 class="t-h2" style="margin-top: 8px;">The four things we got right for you.</h2>
			</header>

			<div class="module-grid">
				{
					sp.why.map(([title, blurb], i) => (
						<article class="module-card">
							<div class="module-card__icon">
								<Icon name={WHY_ICONS[i % WHY_ICONS.length]} size={20} />
							</div>
							<div class="module-card__title">{title}</div>
							<div class="module-card__blurb">{blurb}</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section section--tight">
		<div class="container">
			<header class="section-header">
				<span class="t-eyebrow">Live preview</span>
				<h2 class="t-h2" style="margin-top: 8px;">
					This is what {sp.label} looks like in Lucoze.
				</h2>
			</header>
			<SpecialtyVisual kind={sp.dashSpecialty} />
		</div>
	</section>

	{
		sp.detail.length > 0 && (
			<section class="section section--tight">
				<div class="container">
					<article class="post" style="margin: 0 auto;">
						{sp.detail.map((d) => (
							<>
								<h2>{d.title}</h2>
								<p>{d.body}</p>
							</>
						))}
					</article>
				</div>
			</section>
		)
	}

	{
		sp.faqs.length > 0 && (
			<section class="section section--tight">
				<div class="container">
					<header class="section-header">
						<span class="t-eyebrow">Common questions</span>
						<h2 class="t-h2" style="margin-top: 8px;">
							{sp.label}, the questions we hear first.
						</h2>
					</header>
					<Faq items={sp.faqs} />
				</div>
			</section>
		)
	}

	<section
		class="section section--tight"
		style="background: var(--paper); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);"
	>
		<div class="container" style="text-align: center;">
			<span class="t-eyebrow">Plan that fits</span>
			<h2 class="t-h2" style="margin: 8px 0 var(--s-4);">{sp.plan}</h2>
			<p class="t-lead" style="margin: 0 auto var(--s-6); max-width: 540px;">
				Includes all features above plus migration support and 14-day free trial.
				<a href="/in/pricing/" style="color: var(--primary); font-weight: 600;">See pricing →</a>
			</p>
			<a href="/in/demo/" class="btn btn--accent btn--lg">
				Book a demo — {sp.label}
				<Icon name="arrow" size={16} class="btn__arrow" />
			</a>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="cta-final" style="padding: var(--s-12) var(--s-8);">
				<h2 style="font-size: clamp(24px, 3vw, 36px); margin-bottom: var(--s-3);">
					Talk to us about {sp.label}.
				</h2>
				<p>We'll skip the demo if you'd rather just ask questions. 30 minutes, founder included.</p>
				<div class="cta-final__actions">
					<a href="/in/contact/" class="btn btn--primary btn--lg">
						Book a call
						<Icon name="arrow" size={16} class="btn__arrow" />
					</a>
					<a href="/in/design-partner/" class="btn btn--ghost btn--lg"> Apply as design partner </a>
				</div>
			</div>
		</div>
	</section>
</Base>
